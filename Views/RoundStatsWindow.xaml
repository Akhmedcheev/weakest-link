<Window x:Class="WeakestLink.Views.RoundStatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Round Analytics [Mission Control]" Height="700" Width="1000"
        Background="{StaticResource TVSafeSubtle}" Foreground="{StaticResource ObsidianTextPrimary}"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanMinimize">
        
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="{DynamicResource CornerRadiusNone}"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource TVSafeBorder}" BorderThickness="1" Background="{StaticResource TVSafeSubtle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource TVSafePanel}" BorderBrush="{StaticResource TVSafeBorder}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="ROUND ANALYTICS [MISSION CONTROL]" 
                               Foreground="{StaticResource ObsidianTextDisabled}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" 
                               VerticalAlignment="Center" Margin="15,0" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="—" Style="{StaticResource WindowControlButton}" Click="BtnMinimize_Click"/>
                        <Button Content="✕" Style="{StaticResource WindowCloseButton}" Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

        <!-- TOP: Prediction Card -->
        <Border Grid.Row="0" Style="{StaticResource SurfaceCard}" BorderBrush="{StaticResource ColorRed}">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="ELIMINATION PREDICTOR" FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource ObsidianTextDisabled}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock x:Name="PredictionText" Text="Прогноз: Ожидание..." FontSize="{DynamicResource FontSizeGameQuestion}" FontWeight="Bold" Foreground="{StaticResource ColorRed}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ExplanationText" Text="Обоснование решения" FontSize="{DynamicResource FontSizeBody}" Foreground="{StaticResource ObsidianTextDisabled}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                
                <Border x:Name="TieBanner" Background="{StaticResource ColorRed}" CornerRadius="{DynamicResource CornerRadiusStandard}" Padding="10,4" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="TieBannerText" Text="НИЧЬЯ" FontSize="{DynamicResource FontSizeSubheader}" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- CENTER: DataGrid -->
        <Border Grid.Row="1" Style="{StaticResource SurfaceCard}" Padding="5">
            <DataGrid x:Name="PlayersDataGrid" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False" 
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserSortColumns="True"
                      GridLinesVisibility="None"
                      Background="Transparent"
                      BorderThickness="0"
                      RowBackground="Transparent"
                      RowHeaderWidth="0"
                      Foreground="{StaticResource ObsidianTextPrimary}"
                      FontSize="{DynamicResource FontSizeSubheader}"
                      LoadingRow="GridPlayerStats_LoadingRow">
                
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#808080"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Height" Value="35"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="5,0"/>
                        <!-- Caps-like text appearance for header -->
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#262626"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#262626"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="Padding" Value="0,5"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#222222"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ИМЯ" Binding="{Binding Name}" Width="*" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="10,0"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="ВЕРНО" Binding="{Binding CorrectAnswers}" Width="80" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#E0E0E0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="ОШИБКИ" Binding="{Binding TotalMistakes}" Width="80" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#da373c"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="В БАНК" Binding="{Binding BankedMoney, StringFormat={}{0:N0} ₽}" Width="100" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#00DDFF"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="СРЕД. БАНК" Width="100" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#7a2ad1"/>
                                <Setter Property="Text" Value="{Binding AverageBankAmount, StringFormat={}{0:N0} ₽}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BankPressCount}" Value="0">
                                        <Setter Property="Text" Value="—"/>
                                        <Setter Property="Foreground" Value="#404040"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="%" Width="80" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#808080"/>
                                <Setter Property="Text" Value="{Binding SuccessPercentage, StringFormat={}{0:F1}%}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TotalQuestions}" Value="0">
                                        <Setter Property="Text" Value="—"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- BOTTOM: Metric Cards -->
        <WrapPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
            <Border Style="{StaticResource MetricCard}">
                <StackPanel>
                    <TextBlock Text="В БАНК" FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource ObsidianTextDisabled}"/>
                    <TextBlock x:Name="TotalBankedText" Text="0 ₽" FontSize="{DynamicResource FontSizeLarge}" FontWeight="Bold" Foreground="{StaticResource TVSafeCyan}" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}">
                <StackPanel>
                    <TextBlock Text="СГОРЕЛО" FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource ObsidianTextDisabled}"/>
                    <TextBlock x:Name="TotalBurnedText" Text="0 ₽" FontSize="{DynamicResource FontSizeLarge}" FontWeight="Bold" Foreground="{StaticResource ColorRed}" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}">
                <StackPanel>
                    <TextBlock Text="ЭФФЕКТИВНОСТЬ" FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource ObsidianTextDisabled}"/>
                    <TextBlock x:Name="EfficiencyText" Text="0%" FontSize="{DynamicResource FontSizeLarge}" FontWeight="Bold" Foreground="{StaticResource ColorGold}" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}">
                <StackPanel>
                    <TextBlock Text="СИЛЬНОЕ ЗВЕНО" FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource ObsidianTextDisabled}"/>
                    <TextBlock x:Name="StrongestLinkText" Text="—" FontSize="{DynamicResource FontSizeLarge}" FontWeight="Bold" Foreground="{StaticResource ColorSuccess}" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}">
                <StackPanel>
                    <TextBlock Text="PANIC BANKER" FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource ObsidianTextDisabled}"/>
                    <TextBlock x:Name="PanicBankerText" Text="—" FontSize="{DynamicResource FontSizeHeader}" FontWeight="Bold" Foreground="{StaticResource ColorPurple}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="ЭКСПОРТ CSV" Style="{StaticResource FlatButton}" Width="150" Margin="0,0,10,0" Click="BtnExportCsv_Click"/>
            <Button Content="ЗАКРЫТЬ" Style="{StaticResource RedButton}" Width="150" Click="BtnClose_Click"/>
        </StackPanel>

            </Grid>
        </Grid>
    </Border>
</Window>
