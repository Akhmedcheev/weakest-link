                    <!-- 0. SETUP CONTEXT - Лобби / формирование команды -->
                    <Grid x:Name="SetupContext" Visibility="Visible">
                        <Border x:Name="SetupPanel" Background="Transparent" Padding="20,20" CornerRadius="12">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <ContextMenu.Template>
                                        <ControlTemplate TargetType="ContextMenu">
                                            <Border Background="#16191F" BorderBrush="{StaticResource ObsidianBorderStrong}" BorderThickness="1" CornerRadius="8" Padding="4">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Opacity="0.6"/>
                                                </Border.Effect>
                                                <StackPanel IsItemsHost="True"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ContextMenu.Template>
                                    <MenuItem Header="🎲 ЗАПОЛНИТЬ СЛУЧАЙНЫМИ" Click="BtnFillRandom_Click" FontWeight="Bold"
                                              Foreground="White" FontSize="{DynamicResource FontSizeSmall}">
                                        <MenuItem.Style>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="MenuItem">
                                                            <Border x:Name="bg" Background="Transparent" Padding="14,8" CornerRadius="6" Cursor="Hand">
                                                                <ContentPresenter ContentSource="Header"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsHighlighted" Value="True">
                                                                    <Setter TargetName="bg" Property="Background" Value="{StaticResource ObsidianCard}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </MenuItem.Style>
                                    </MenuItem>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Заголовок -->
                                <StackPanel Grid.Row="0" Margin="4,0,4,12">
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="СОСТАВ КОМАНДЫ" Foreground="#E2E5F0" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Border Background="#2B303B" CornerRadius="12" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtRosterCount" Text="0 / 8 ИГРОКОВ" Foreground="#A0A5B5" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border x:Name="TxtRosterConfirmedBadge" Background="#1C212A" BorderBrush="#0A84FF" BorderThickness="1" CornerRadius="12" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                                <TextBlock x:Name="TxtRosterConfirmed" Text="✓ УТВЕРЖДЁН" Foreground="#0A84FF" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <Border Height="1" Background="#1C1F26" Margin="0,0,0,0"/>
                                </StackPanel>

                                <!-- Карточки участников (портретный грид) -->
                                <ItemsControl Grid.Row="1" x:Name="LstPlayers" HorizontalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="CardRoot" Width="106" Margin="4" Padding="0" Cursor="Hand"
                                                    CornerRadius="8" ClipToBounds="True"
                                                    BorderBrush="#252A36" BorderThickness="1"
                                                    Background="#16191F"
                                                    MouseLeftButtonDown="PlayerCard_Click">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Фото-зона -->
                                                    <Border Grid.Row="0" Height="80" ClipToBounds="True" Cursor="Hand"
                                                            MouseLeftButtonDown="PlayerPhoto_Click"
                                                            ToolTip="Нажмите для загрузки фото"
                                                            Background="#0F1115">
                                                        <Grid>
                                                            <Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"
                                                                  Fill="#2A303C" Stretch="Uniform"
                                                                  Width="32" Height="32"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  Opacity="0.8"/>
                                                            <Image Source="{Binding PhotoSource}" Stretch="UniformToFill"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Нейплейт -->
                                                    <Border Grid.Row="1" Padding="6,8" Background="#16191F" BorderBrush="#252A36" BorderThickness="0,1,0,0">
                                                        <StackPanel>
                                                            <TextBox Text="{Binding GameName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                     Background="Transparent" Foreground="White" CaretBrush="White"
                                                                     BorderThickness="0"
                                                                     FontSize="12" FontWeight="Bold" TextAlignment="Center"
                                                                     Padding="0" Margin="0,0,0,2"
                                                                     KeyDown="RosterTextBox_KeyDown"/>
                                                            <TextBox Text="{Binding CityDesc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                     Background="Transparent" Foreground="#8A91A6" CaretBrush="White"
                                                                     BorderThickness="0"
                                                                     FontSize="9" TextAlignment="Center"
                                                                     Padding="0" Margin="0"
                                                                     KeyDown="RosterTextBox_KeyDown"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Бейдж-номер -->
                                                    <Border Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                            Width="20" Height="20"
                                                            CornerRadius="0,0,8,0"
                                                            Background="#0A84FF">
                                                        <TextBlock Text="{Binding ConsoleNumber}" Foreground="White" 
                                                                   FontSize="10" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CardRoot" Property="BorderBrush" Value="#0A84FF"/>
                                                    <Setter TargetName="CardRoot" Property="Background" Value="#1C212A"/>
                                                    <Setter TargetName="CardRoot" Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect ShadowDepth="2" BlurRadius="12" Opacity="0.3" Color="#000000"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

