                                                    <TextBlock Text="▶" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.8"/>
                                                    <TextBlock Text="START SESSION" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 1. PLAY CONTEXT - Текущая игра -->
                    <Grid x:Name="PlayContext" Visibility="Collapsed">
                    <Grid x:Name="GamePlayPanel" Visibility="Collapsed" Margin="0" Background="Transparent">
