                                                           FontSize="28" FontWeight="ExtraBold" FontFamily="JetBrains Mono, Consolas"
                                                           HorizontalAlignment="Center">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect Color="#14B8A6" BlurRadius="10" ShadowDepth="0" Opacity="0.4"/>
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- RIGHT: Вопрос + кнопки действий -->
                        <Border Grid.Column="1" Background="#0F1115" CornerRadius="0,12,12,0" BorderBrush="#252A36" BorderThickness="0,1,1,1" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- ПОЛОСА: ТЕКУЩИЙ ИГРОК + ПОСЛЕДНИЙ РЕЗУЛЬТАТ (Row 0) -->
                                <Grid Grid.Row="0" Margin="16,16,16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="220"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Текущий игрок (кому задаётся вопрос) -->
                                    <Border Grid.Column="0" Background="#16191F" CornerRadius="8,0,0,8"
                                            BorderBrush="#252A36" BorderThickness="1,1,0,1" Padding="16,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#127908;" FontSize="16" Foreground="#0A84FF" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <StackPanel>
                                                <TextBlock Text="ВОПРОС К:" Foreground="#747A8A"
                                                           FontSize="10" FontWeight="Bold" Margin="0,0,0,2"/>
                                                <TextBlock x:Name="TxtCurrentPlayerInfo"
                                                           Text="—" Foreground="White"
                                                           FontSize="16" FontWeight="Bold"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Последний результат -->
                                    <Border x:Name="TxtLastResultBorder" Grid.Column="1"
                                            Background="#16191F" CornerRadius="0,8,8,0"
                                            BorderBrush="#252A36" BorderThickness="1,1,1,1"
                                            Padding="16,10">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="ПОСЛЕДНЕЕ ДЕЙСТВИЕ:" Foreground="#747A8A"
                                                       FontSize="10" FontWeight="Bold" Margin="0,0,0,2"/>
                                            <TextBlock x:Name="TxtLastResultInfo"
                                                       Text="—" Foreground="#A0A5B5"
                                                       FontSize="14" FontWeight="Bold"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Логотип/заглушка (когда нет вопроса) -->
                                <StackPanel x:Name="LinkLogoPanel" Grid.Row="1" Opacity="0.05" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="/Assets/Images/logotipka.png" Height="180" Stretch="Uniform"/>
                                </StackPanel>

                                <!-- Область вопроса -->
                                <Border x:Name="QuestionCard" Grid.Row="1" Background="#16191F" Padding="32,24" Margin="16,16,16,16"
                                        CornerRadius="12" BorderBrush="#252A36" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <TextBlock x:Name="TxtCurrentQuestion" Grid.Row="0" Text="Ожидание вопроса..." 
                                                   Foreground="White" FontSize="26" FontWeight="Bold" 
                                                   TextWrapping="Wrap" TextAlignment="Center" 
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   Margin="20,0"/>
                                        <TextBlock x:Name="TxtCurrentAnswer" Grid.Row="1" Text="ОТВЕТ: —" 
                                                   Foreground="#E54D4D" FontSize="20" FontWeight="ExtraBold"
                                                   HorizontalAlignment="Center" Margin="0,20,0,0">
                                            <TextBlock.Effect>
                                                <DropShadowEffect Color="#E54D4D" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="2" Margin="16,0,16,16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- START — маленькая жёлтая кнопка справа сверху (как на пульте) -->
                                    <Button Grid.Row="0" x:Name="BtnGamePlayPlay"
                                            Width="120" Height="40" HorizontalAlignment="Right"
                                            Background="#F1C40F" Foreground="#1A1500"
                                            BorderBrush="Transparent" BorderThickness="0"
                                            Margin="0,0,0,12"
                                            Click="BtnPlay_Click" Style="{StaticResource GameButtonPressStyle}">
                                        <Grid>
                                            <TextBlock Text="▶ START" FontSize="14" FontWeight="ExtraBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>

                                    <!-- Wrong | BANK | Correct — основной ряд кнопок -->
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Wrong [B] -->
                                        <Button x:Name="BtnWrong" Grid.Column="0" Height="90"
                                                Click="BtnWrong_Click" Style="{StaticResource RedButton}"
                                                FontSize="22" FontWeight="ExtraBold" Content="Wrong">
                                        </Button>
                                        <!-- BANK [C] -->
                                        <Button x:Name="BtnBank" Grid.Column="2" Height="100"
                                                Click="BtnBank_Click" Style="{StaticResource AccentButton}"
                                                FontSize="26" FontWeight="ExtraBold" Content="BANK">
                                        </Button>
                                        <!-- Correct [A] -->
                                        <Button x:Name="BtnCorrect" Grid.Column="4" Height="90"
                                                Click="BtnCorrect_Click" Style="{StaticResource SuccessButton}"
                                                FontSize="22" FontWeight="ExtraBold" Content="Correct">
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="HeadToHeadPanel" Visibility="Collapsed" Background="Transparent" Margin="0">
                        <Border Background="#16191F" BorderBrush="#252A36" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0">
                        <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions> <ColumnDefinition Width="*"/> <ColumnDefinition Width="*"/> </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="TxtFinalist1" Text="ФИНАЛИСТ 1" FontSize="20" Foreground="#0A84FF" FontWeight="Black" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <Ellipse x:Name="P1_C1" Width="20" Height="20" Margin="4" Stroke="#252A36" StrokeThickness="2" Fill="Transparent"/>
                                    <Ellipse x:Name="P1_C2" Width="20" Height="20" Margin="4" Stroke="#252A36" StrokeThickness="2" Fill="Transparent"/>
                                    <Ellipse x:Name="P1_C3" Width="20" Height="20" Margin="4" Stroke="#252A36" StrokeThickness="2" Fill="Transparent"/>
                                    <Ellipse x:Name="P1_C4" Width="20" Height="20" Margin="4" Stroke="#252A36" StrokeThickness="2" Fill="Transparent"/>
                                    <Ellipse x:Name="P1_C5" Width="20" Height="20" Margin="4" Stroke="#252A36" StrokeThickness="2" Fill="Transparent"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="TxtFinalist2" Text="ФИНАЛИСТ 2" FontSize="20" Foreground="#0A84FF" FontWeight="Black" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <Ellipse x:Name="P2_C1" Width="20" Height="20" Margin="4" Stroke="#252A36" StrokeThickness="2" Fill="Transparent"/>
                                    <Ellipse x:Name="P2_C2" Width="20" Height="20" Margin="4" Stroke="#252A36" StrokeThickness="2" Fill="Transparent"/>
                                    <Ellipse x:Name="P2_C3" Width="20" Height="20" Margin="4" Stroke="#252A36" StrokeThickness="2" Fill="Transparent"/>
                                    <Ellipse x:Name="P2_C4" Width="20" Height="20" Margin="4" Stroke="#252A36" StrokeThickness="2" Fill="Transparent"/>
                                    <Ellipse x:Name="P2_C5" Width="20" Height="20" Margin="4" Stroke="#252A36" StrokeThickness="2" Fill="Transparent"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Border x:Name="FinalPrestartBorder" Background="#0F1115" Margin="0" Padding="16" CornerRadius="8" BorderBrush="#252A36" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Кто отвечает первым?" Foreground="#747A8A" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>
                                    <ComboBox x:Name="CmbFirstResponder" Height="40" FontSize="14" Margin="0,0,0,16" Background="#16191F" Foreground="White" BorderBrush="#252A36" BorderThickness="1"/>
                                    <Button x:Name="BtnApplyDuel" Content="ПРИМЕНИТЬ" Style="{StaticResource SuccessButton}" Height="44" FontWeight="Bold" Click="BtnApplyDuel_Click"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="BtnStartDuel" Content="СТАРТ ДУЭЛИ" Style="{StaticResource SuccessButton}" Height="50" FontWeight="Bold" Margin="0" VerticalAlignment="Top" Visibility="Collapsed" Click="BtnStartDuel_Click"/>
                        </Grid>
                        <Border Grid.Row="2" Background="#0F1115" Margin="0,0,0,16" Padding="24" CornerRadius="8" MinHeight="150" BorderBrush="#252A36" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TurnTextBlock" Text="ОЧЕРЕДЬ: ИГРОК 1" Foreground="#F1C40F" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="FinalQuestionTextBlock" Text="ВОПРОС ФИНАЛА" Foreground="White" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12"/>
                                <TextBlock x:Name="TxtDuelAnswer" Text="ОТВЕТ: —" Foreground="#0A84FF" FontSize="20" FontWeight="ExtraBold" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <UniformGrid Grid.Row="3" Columns="2" Margin="0">
                            <Button x:Name="BtnDuelCorrect" Content="ВЕРНО" Height="70" FontSize="20" FontWeight="Bold" Margin="0,0,8,0" Click="BtnDuelCorrect_Click" Style="{StaticResource SuccessButton}"/>
                            <Button x:Name="BtnDuelWrong" Content="НЕВЕРНО" Height="70" FontSize="20" FontWeight="Bold" Margin="8,0,0,0" Click="BtnDuelWrong_Click" Style="{StaticResource RedButton}"/>
                        </UniformGrid>
                        </Grid>
                        </Border>
                    </Grid>

                    <!-- 4. ПОБЕДА -->
                    <Grid x:Name="WinnerPanel" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" Background="#0F1115">
                        <Border Background="#16191F" CornerRadius="12" Padding="48,40" 
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                MaxWidth="500" BorderBrush="#252A36" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="ПОБЕДИТЕЛЬ" Foreground="#747A8A" FontSize="14" FontWeight="Bold" 
                                           HorizontalAlignment="Center" Margin="0,0,0,12" FontFamily="Segoe UI"/>
                                <TextBlock x:Name="TxtFinalWinnerName" Text="ИМЯ" Foreground="White" 
                                           FontSize="42" FontWeight="ExtraBold" HorizontalAlignment="Center" 
                                           FontFamily="Segoe UI" Margin="0,0,0,8"/>
                                <Border Height="1" Background="#252A36" Margin="20,12,20,16"/>
                                <TextBlock x:Name="TxtFinalWinnings" Text="0 ₽" Foreground="#238636" 
                                           FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" 
                                           Margin="0,0,0,32" FontFamily="Segoe UI"/>
                                <Button x:Name="BtnEndShow" Content="ЗАВЕРШИТЬ ИГРУ" 
                                        Style="{StaticResource AccentButton}" 
                                        Foreground="White" FontSize="16" FontFamily="Segoe UI" FontWeight="Bold"
                                        Padding="40,16" HorizontalAlignment="Center"
                                        Click="BtnEndShow_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    </Grid>
                    
                    <!-- TRANSITION OVERLAY -->
                    <Grid x:Name="TransitionOverlay" Visibility="Collapsed" Background="#0F1115" Panel.ZIndex="100">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtTransitionTitle" Text="ИТОГИ РАУНДА" 
                                       Foreground="#0A84FF" FontSize="42" FontWeight="ExtraBold" 
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtTransitionSub" Text="Переход к аналитике..." 
                                       Foreground="#747A8A" FontSize="16" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- VOTE POPUP OVERLAY -->
                    <Grid x:Name="VotePopupOverlay" Visibility="Collapsed" Background="#E6050505" Panel.ZIndex="101">
                        <Border Background="#16191F" CornerRadius="12" Padding="24" BorderBrush="#252A36" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="320" Effect="{StaticResource StudioCardShadow}">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <TextBlock Text="ГОЛОСУЕТ ЗА:" Foreground="#747A8A" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnCloseVotePopup" Content="✕" HorizontalAlignment="Right" Width="24" Height="24" Background="Transparent" Foreground="#747A8A" BorderThickness="0" Click="BtnCloseVotePopup_Click" Cursor="Hand" ToolTip="Закрыть"/>
                                </Grid>
                                <ItemsControl x:Name="VoteEntriesPanel">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4" Height="32">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="140"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableTargets}"
                                                          SelectedItem="{Binding SelectedVote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          ItemContainerStyle="{StaticResource PremiumComboBoxItem}"
                                                          Height="32" FontSize="12" VerticalAlignment="Center" Padding="8,4"
                                                          Background="{StaticResource StudioBg}" Foreground="White" BorderThickness="1" BorderBrush="{StaticResource StudioCardBorder}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button x:Name="BtnAcceptVotes" Content="ПРИНЯТЬ" Margin="0,20,0,0" Height="40" FontWeight="Bold" FontSize="12" Foreground="White"
                                        Click="BtnAcceptVotes_Click" Style="{StaticResource PillButton}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 2. ANALYTICS CONTEXT - Dashboard -->
                    <Grid x:Name="AnalyticsContext" Visibility="Collapsed" Background="Transparent" Margin="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Заголовок и фильтр (Studio variant: больше воздуха, мягкий акцент) -->
                        <Border Grid.Row="0" Background="{StaticResource StudioCardBg}" BorderBrush="{StaticResource StudioCardBorder}" BorderThickness="0,0,0,1" Padding="24,16" Margin="12,16,12,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📊" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtAnalyticsTitle" Text="ANALYTICS" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Фильтр по раундам -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtRoundFilterLabel" Text="РАУНД:" Foreground="{StaticResource StudioTextMuted}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Border x:Name="RoundFilterContainer" CornerRadius="10" Background="{StaticResource StudioBg}" BorderBrush="{StaticResource StudioCardBorder}" BorderThickness="1" Padding="4">
                                        <StackPanel x:Name="RoundFilterButtons" Orientation="Horizontal">
                                            <ToggleButton Content="R1" Tag="1" Width="40" Height="26" Style="{StaticResource SegmentedToggleStyle}" Click="BtnRoundFilter_Click"/>
                                            <ToggleButton Content="R2" Tag="2" Width="40" Height="26" Style="{StaticResource SegmentedToggleStyle}" Click="BtnRoundFilter_Click"/>
                                            <ToggleButton Content="R3" Tag="3" Width="40" Height="26" Style="{StaticResource SegmentedToggleStyle}" Click="BtnRoundFilter_Click"/>
                                            <ToggleButton Content="R4" Tag="4" Width="40" Height="26" Style="{StaticResource SegmentedToggleStyle}" Click="BtnRoundFilter_Click"/>
                                            <ToggleButton Content="R5" Tag="5" Width="40" Height="26" Style="{StaticResource SegmentedToggleStyle}" Click="BtnRoundFilter_Click"/>
                                            <ToggleButton Content="R6" Tag="6" Width="40" Height="26" Style="{StaticResource SegmentedToggleStyle}" Click="BtnRoundFilter_Click"/>
                                            <ToggleButton Content="R7" Tag="7" Width="40" Height="26" Style="{StaticResource SegmentedToggleStyle}" Click="BtnRoundFilter_Click"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <TextBlock Grid.Column="2" x:Name="TxtPredictionLabel" Text="ПРОГНОЗ ВЫБЫВАНИЯ" Foreground="#E54D4D" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Ключевые метрики — Studio: карточки с тенью, 16px скругление, teal акцент -->
                        <UniformGrid Grid.Row="1" Columns="4" Margin="12,0,12,12">
                            <Border Background="{StaticResource StudioCardBg}" BorderBrush="{StaticResource StudioCardBorder}" BorderThickness="1" CornerRadius="16" Padding="20,14" Margin="0,0,6,0" Effect="{StaticResource StudioCardShadow}">
                                <StackPanel>
                                    <TextBlock Text="ИГРЫ" Foreground="{StaticResource StudioTextMuted}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtAnalyticsTotalGames" Text="0" Foreground="{StaticResource StudioAccent}" FontSize="22" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource StudioCardBg}" BorderBrush="{StaticResource StudioCardBorder}" BorderThickness="1" CornerRadius="16" Padding="20,14" Margin="6,0" Effect="{StaticResource StudioCardShadow}">
                                <StackPanel>
                                    <TextBlock Text="СР. БАНК" Foreground="{StaticResource StudioTextMuted}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtAnalyticsAvgBank" Text="0 ₽" Foreground="#238636" FontSize="22" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource StudioCardBg}" BorderBrush="{StaticResource StudioCardBorder}" BorderThickness="1" CornerRadius="16" Padding="20,14" Margin="6,0" Effect="{StaticResource StudioCardShadow}">
                                <StackPanel>
                                    <TextBlock Text="СИЛЬНОЕ ЗВЕНО" Foreground="{StaticResource StudioTextMuted}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtAnalyticsBestPlayer" Text="—" Foreground="#F1C40F" FontSize="22" FontWeight="Bold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource StudioCardBg}" BorderBrush="{StaticResource StudioCardBorder}" BorderThickness="1" CornerRadius="16" Padding="20,14" Margin="6,0,0,0" Effect="{StaticResource StudioCardShadow}">
                                <StackPanel>
                                    <TextBlock Text="ВРЕМЯ РАУНДА" Foreground="{StaticResource StudioTextMuted}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtAnalyticsPlayTime" Text="00:00" Foreground="#E54D4D" FontSize="22" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        
                        <!-- Таблица слева, голоса справа + Film Voting под ними -->
                        <Grid Grid.Row="2" Margin="12,0,12,12" UseLayoutRounding="True">
                            <Grid.RowDefinitions>
                                <!-- Таблица займет оставшееся место, а панель голосования - сколько ей нужно снизу -->
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" SnapsToDevicePixels="True">
                            <Grid>
                                <!-- Таблица аналитики (Studio: мягкая карточка, 16px скругление) -->
                                <Border Background="{StaticResource StudioCardBg}" BorderBrush="{StaticResource StudioCardBorder}" BorderThickness="1" CornerRadius="16" Padding="12" ClipToBounds="True" Effect="{StaticResource StudioCardShadow}">
                                    <DataGrid x:Name="AnalyticsPlayersGrid"
                                             Background="Transparent" 
                                             Foreground="White"
                                             GridLinesVisibility="Horizontal" 
                                             HorizontalGridLinesBrush="#1C1F26"
                                             VerticalGridLinesBrush="Transparent"
                                             HeadersVisibility="Column"
                                             AutoGenerateColumns="False"
                                             CanUserAddRows="False" CanUserDeleteRows="False"
                                             CanUserReorderColumns="False" CanUserSortColumns="True"
                                             SelectionMode="Single" IsReadOnly="True"
                                             AlternatingRowBackground="Transparent"
                                             RowBackground="Transparent"
                                             BorderThickness="0"
                                             RowHeight="36">
                                        <DataGrid.Resources>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="{StaticResource StudioBg}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource StudioCardBorder}"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                <Setter Property="Foreground" Value="#A0A5B5"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="FontSize" Value="10"/>
                                                <Setter Property="Padding" Value="12,10"/>
                                            </Style>
                                            <Style TargetType="DataGridRow">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="MinHeight" Value="32"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1C212A"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="#264F78"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.Resources>
                                        <DataGrid.CellStyle>
                                            <Style TargetType="DataGridCell">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="Padding" Value="12,4"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="DataGridCell">
                                                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                                <ContentPresenter VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.CellStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ИГРОК" Width="130" Binding="{Binding Name}">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="FontSize" Value="13"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="ВЕРНО" Width="70" Binding="{Binding CorrectAnswers}">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#238636"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="TextAlignment" Value="Center"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="НЕВЕРНО" Width="75" Binding="{Binding WrongAnswers}">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#E54D4D"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="TextAlignment" Value="Center"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="ПОТЕРИ" Width="80" Binding="{Binding MoneyLost, StringFormat=N0}">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#E54D4D"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="TextAlignment" Value="Center"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="Opacity" Value="0.7"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="БАНК" Width="80" Binding="{Binding BankedAmount}">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#F1C40F"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="TextAlignment" Value="Center"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="ПРОТИВ" Width="*" Binding="{Binding SelectedVote}">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#0A84FF"/>
                                                        <Setter Property="FontWeight" Value="ExtraBold"/>
                                                        <Setter Property="TextAlignment" Value="Left"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="ПРОГНОЗ" Width="SizeToCells" Binding="{Binding Prediction}">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#E67E22"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="TextAlignment" Value="Center"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>
                        </Grid>

                        <!-- ========== СЪЁМОЧНОЕ ГОЛОСОВАНИЕ: Утилитарный пульт оператора ========== -->
                        <Border x:Name="FilmVotingPanel" Grid.Row="1" Background="Transparent" 
                                Margin="0,8,0,0" Padding="0,8,0,0" Visibility="Collapsed" 
                                BorderBrush="#252A36" BorderThickness="0,1,0,0" 
                                UseLayoutRounding="True" SnapsToDevicePixels="True">
                            <StackPanel>
                                <!-- Header: строгий, плоский -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🎬" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#747A8A"/>
                                        <TextBlock x:Name="TxtFilmVotePhase" Text="ОБСУЖДЕНИЕ И ИТОГИ" 
                                                   Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtFilmVoteStep" Text="ШАГ 1/4" Grid.Column="1"
                                               Foreground="#747A8A" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Stepper: Плоские матовые кнопки -->
                                <UniformGrid Columns="4" Margin="0,0,0,8">
                                    <Button x:Name="BtnFilmSting" Content="1. ОТБИВКА" Height="28" Margin="0,0,2,0"
                                            Click="BtnFilmSting_Click" Style="{StaticResource FlatButton}" 
                                            Background="#0F1115" BorderBrush="#252A36" BorderThickness="1" Foreground="#A0A5B5" FontWeight="SemiBold" FontSize="10"/>
                                    <Button x:Name="BtnFilmMotor" Content="2. МОТОР" Height="28" Margin="2,0"
                                            Click="BtnFilmMotor_Click" Style="{StaticResource FlatButton}" 
                                            Background="#0F1115" BorderBrush="#252A36" BorderThickness="1" Foreground="#A0A5B5" FontWeight="SemiBold" FontSize="10"/>
                                    <Button x:Name="BtnFilmReveal" Content="3. ТАБЛИЧКИ" Height="28" Margin="2,0"
                                            Click="BtnFilmReveal_Click" Style="{StaticResource FlatButton}" 
                                            Background="#0F1115" BorderBrush="#252A36" BorderThickness="1" Foreground="#A0A5B5" FontWeight="SemiBold" FontSize="10"/>
                                    <Button x:Name="BtnFilmDiscussion" Content="4. ОБСУЖДЕНИЕ" Height="28" Margin="2,0,0,0"
                                            Click="BtnFilmDiscussion_Click" Style="{StaticResource FlatButton}" 
                                            Background="#0F1115" BorderBrush="#252A36" BorderThickness="1" Foreground="#A0A5B5" FontWeight="SemiBold" FontSize="10"/>
                                </UniformGrid>

                                <!-- Зона контента -->
                                <Grid>
                                    <!-- Step 2: подсказка -->
                                    <Border x:Name="FilmVoteCollectionPanel" Visibility="Collapsed" Padding="0" Height="0" BorderThickness="0"/>

                                    <!-- Step 3 & 4: итоги -->
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- ИТОГИ ГОЛОСОВАНИЯ -->
                                        <Border x:Name="FilmVoteResultsPanel" Grid.Row="0" Visibility="Collapsed" Background="#0F1115" Padding="12" CornerRadius="6" BorderBrush="#252A36" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="РАСПРЕДЕЛЕНИЕ ГОЛОСОВ:" Foreground="#747A8A" 
                                                           FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>
                                                <TextBlock x:Name="TxtFilmVoteResults" Foreground="White" 
                                                           FontSize="12" TextWrapping="Wrap" FontFamily="Consolas"/>
                                                <Border Height="1" Background="#252A36" Margin="0,8"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="TxtFilmVoteTally" Foreground="#0A84FF" 
                                                               FontSize="12" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                    <Button x:Name="BtnFilmEliminate" Grid.Column="1" Margin="12,0,0,0" Content="ИСКЛЮЧИТЬ" Width="100" Height="28"
                                                            Click="BtnFilmEliminate_Click" Style="{StaticResource RedButton}" FontSize="11" FontWeight="Bold" Visibility="Hidden"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Ничья (Стиль Warning) -->
                                        <Border x:Name="FilmTieInfoPanel" Grid.Row="1" Background="#261A13" CornerRadius="6" 
                                                Padding="12" Margin="0,8,0,0" Visibility="Collapsed" BorderBrush="#E67E22" BorderThickness="1,0,0,0">
                                            <StackPanel>
                                                <TextBlock x:Name="TxtFilmTieInfo" Text="" 
                                                           Foreground="#E67E22" FontWeight="Bold" 
                                                           FontSize="11" Margin="0,0,0,6"/>
                                                <ItemsControl x:Name="FilmTieCandidates"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>
                        </Grid>
                        <Border Grid.Row="3" Background="{StaticResource StudioCardBg}" BorderBrush="{StaticResource StudioCardBorder}" BorderThickness="0,1,0,0" Padding="24,16" Margin="12,0,12,12" CornerRadius="0,0,16,16" Visibility="Collapsed" Height="0">
                            <StackPanel>
                                <!-- === EXPRESS VOTING PANEL === -->
                                <StackPanel x:Name="ExpressVotingPanel" Visibility="Collapsed">
                                <!-- Voting duration selector -->
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ТАЙМЕР ГОЛОСОВАНИЯ" Foreground="{StaticResource ObsidianTextMuted}" FontSize="{DynamicResource FontSizeXSmall}" FontWeight="Bold"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="CmbVotingDuration" Grid.Column="1" Height="24" FontSize="{DynamicResource FontSizeCaption}" 
                                              Background="#16191F" Foreground="{StaticResource ObsidianText}" BorderThickness="0" SelectedIndex="0">
                                        <ComboBoxItem Content="0:45 (стандарт)" Tag="45"/>
                                        <ComboBoxItem Content="1:00" Tag="60"/>
                                        <ComboBoxItem Content="1:30" Tag="90"/>
                                        <ComboBoxItem Content="2:00" Tag="120"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Voting Stepper -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1.3*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnStartVoting" Grid.Column="0" Content="① VOTE" Height="36" Margin="0,0,2,0"
                                            Foreground="{StaticResource ObsidianTextMuted}" FontWeight="Bold" FontSize="{DynamicResource FontSizeCaption}" Opacity="0.4"
                                            IsEnabled="False" Click="BtnStartVoting_Click" Style="{StaticResource GhostButton}"/>
                                    <Button x:Name="BtnEndVoting" Grid.Column="1" Content="② END" Height="36" Margin="2,0"
                                            Foreground="{StaticResource ObsidianTextMuted}" FontWeight="Bold" FontSize="{DynamicResource FontSizeCaption}" Opacity="0.4"
                                            IsEnabled="False" Click="BtnEndVoting_Click" Style="{StaticResource GhostButton}"/>
                                    <Button x:Name="BtnReveal" Grid.Column="2" Content="③ REVEAL" Height="36" Margin="2,0"
                                            Foreground="{StaticResource ObsidianTextMuted}" FontWeight="Bold" FontSize="{DynamicResource FontSizeCaption}" Opacity="0.4"
                                            IsEnabled="False" Click="BtnReveal_Click" Style="{StaticResource GhostButton}"/>
                                    <Button x:Name="BtnHotDiscussion" Grid.Column="3" Content="④ VERDICT" Height="36" Margin="2,0,0,0"
                                            Foreground="{StaticResource ObsidianTextMuted}" FontWeight="Bold" FontSize="{DynamicResource FontSizeSmall}" Opacity="0.4"
                                            IsEnabled="False" Click="BtnHotDiscussion_Click" Style="{StaticResource GhostButton}"/>
                                </Grid>
                                </StackPanel>

                                <!-- === FULL VOTING PANEL === -->
                                <Border x:Name="FullVotingPanel" Visibility="Collapsed"
                                        Background="{StaticResource ObsidianSurface}" CornerRadius="{DynamicResource CornerRadiusMedium}" Padding="8,6" Margin="0,0,0,4"
                                        BorderBrush="{StaticResource ObsidianBorderStrong}" BorderThickness="1">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="⏸ КТО ЗА КОГО" Foreground="{StaticResource ObsidianTextPrimary}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Button x:Name="BtnConfirmVotes" Grid.Column="1" Content="✓ Подтвердить" 
                                                    Height="24" Padding="10,0"
                                                    Foreground="White" FontSize="{DynamicResource FontSizeXSmall}" FontWeight="Bold"
                                                    Cursor="Hand" Click="BtnConfirmVotes_Click" Style="{StaticResource AccentButton}"/>
                                        </Grid>
                                        <StackPanel x:Name="VoteTableRows"/>
                                    </StackPanel>
                                </Border>

                                <!-- Reveal Timeline -->
                                <Border x:Name="RevealProgressPanel" Background="#0F1115" BorderBrush="#252A36" BorderThickness="1" CornerRadius="8" Margin="0,12,0,0" Padding="12,10" Visibility="Collapsed">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TxtRevealPhase" Text="ИНТРО ВЕДУЩЕЙ" Foreground="#F1C40F" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtRevealTime" Text="0:00 / 0:00" Foreground="#747A8A" FontSize="10" Grid.Column="2" VerticalAlignment="Center"/>
                                        </Grid>
                                        <!-- Segmented timeline background -->
                                        <Grid Height="6" Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="16*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#264F78" CornerRadius="3,0,0,3"/>
                                            <Border Grid.Column="1" Background="#0a2a0a" CornerRadius="0,3,3,0"/>
                                        </Grid>
                                        <ProgressBar x:Name="RevealProgress" Height="6" Margin="0,-10,0,0"
                                                     Minimum="0" Maximum="100" Value="0" 
                                                     Background="Transparent" Foreground="#F1C40F"
                                                     BorderThickness="0"/>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#264F78" CornerRadius="4" Padding="4,2" Margin="0,0,2,0">
                                                <TextBlock Text="ИНТРО" Foreground="#0A84FF" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Border x:Name="RevealCueMarker" Grid.Column="1" Background="#0a2a0a" CornerRadius="4" Padding="4,2" Margin="2,0,0,0">
                                                <TextBlock Text="▶ ВСКРЫТИЕ" Foreground="#238636" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Elimination row -->
                                <Border x:Name="VotingBorder" Background="#1A0D0D" CornerRadius="8" Margin="0,12,0,0" Padding="12,10" 
                                        Visibility="Collapsed" BorderBrush="#E54D4D" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="ИСКЛЮЧИТЬ:" Foreground="#E54D4D" FontSize="11" FontWeight="Bold" 
                                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <ComboBox x:Name="EliminationComboBox" Grid.Column="1" Height="32" FontSize="12" 
                                                  Background="#0F1115" Foreground="White" BorderBrush="#252A36" BorderThickness="1" Margin="0,0,8,0"
                                                  SelectionChanged="EliminationComboBox_SelectionChanged">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" Foreground="{Binding TextColor}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button x:Name="BtnEliminate" Grid.Column="2" Content="ELIMINATE" Width="120" Height="32"
                                                Style="{StaticResource DangerGhostButton}" FontWeight="Bold" FontSize="11"
                                                Click="BtnEliminate_Click"/>
                                    </Grid>
                                </Border>

                                <!-- ========== СЪЁМОЧНОЕ ГОЛОСОВАНИЕ moved above the Decision Hub ========== -->

                                <!-- === MUSIC CONTROL PANEL (скрыта — музыка автоматическая) === -->
                                <Border Background="{StaticResource ObsidianBase}" CornerRadius="{DynamicResource CornerRadiusStandard}" Margin="0,4,0,0" Padding="4,3"
                                        BorderBrush="{StaticResource ObsidianBorder}" BorderThickness="1" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🎵" Foreground="{StaticResource ColorTeams}" FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center" Margin="2,0,4,0"/>
                                        <Button x:Name="BtnMusicReveal" Grid.Column="1" Content="ВСКРЫТ." Height="24" Margin="0,0,2,0"
                                                Background="{StaticResource ObsidianBase}" BorderBrush="{StaticResource ObsidianBorderStrong}" BorderThickness="1"
                                                Foreground="{StaticResource ColorSuccess}" FontWeight="Bold" FontSize="{DynamicResource FontSizeXXSmall}"
                                                Click="BtnMusicReveal_Click" Style="{StaticResource FlatButton}"/>
                                        <Button x:Name="BtnMusicVerdict"
                                                Background="{StaticResource ObsidianBase}" BorderBrush="{StaticResource ObsidianBorderStrong}" BorderThickness="1"
                                                Foreground="{StaticResource ColorOrange}" FontWeight="Bold" FontSize="{DynamicResource FontSizeXXSmall}"
                                                Click="BtnMusicVerdict_Click" Style="{StaticResource FlatButton}"/>
                                        <Button x:Name="BtnMusicGeneralBed"
                                                Background="{StaticResource ObsidianBase}" BorderBrush="{StaticResource ObsidianBorderStrong}" BorderThickness="1"
                                                Foreground="{StaticResource ObsidianTextSecondary}" FontWeight="Bold" FontSize="{DynamicResource FontSizeXXSmall}"
                                                Click="BtnGeneralBed_Click" Style="{StaticResource FlatButton}"/>
                                        <Button x:Name="BtnMusicAfterShame"
                                                Background="{StaticResource ObsidianBase}" BorderBrush="{StaticResource ObsidianBorderStrong}" BorderThickness="1"
                                                Foreground="{StaticResource ObsidianTextSecondary}" FontWeight="Bold" FontSize="{DynamicResource FontSizeXXSmall}"
                                                Click="BtnAfterInterviewBed_Click" Style="{StaticResource FlatButton}"/>
                                        <Button x:Name="BtnMusicStop"
                                                Background="#2A0A0A" BorderBrush="{StaticResource ColorDanger}" BorderThickness="1"
                                                Foreground="{StaticResource ColorDanger}" FontWeight="Bold" FontSize="{DynamicResource FontSizeXXSmall}"
                                                Click="BtnStopAudio_Click" Style="{StaticResource FlatButton}"/>
                                    </Grid>
                                </Border>

                                <!-- Final transition -->
                                <Button x:Name="BtnToFinal" Content="ПЕРЕЙТИ К ФИНАЛУ" Height="36" Margin="0,4,0,0"
                                        FontWeight="Bold" FontSize="{DynamicResource FontSizeSmall}"
                                        Visibility="Collapsed" Click="BtnToFinal_Click" Style="{StaticResource SuccessButton}"/>

                                <!-- Close round -->
                                <Button x:Name="BtnCloseRoundFromAnalytics" Content="CLOSE ROUND" Height="32" Margin="0,4,0,0"
                                        Background="Transparent" BorderBrush="{StaticResource ObsidianBorderStrong}" BorderThickness="1"
                                        Foreground="{StaticResource ObsidianTextDisabled}" FontWeight="Bold" FontSize="{DynamicResource FontSizeXSmall}"
                                        Click="BtnNextRound_Click" Style="{StaticResource FlatButton}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    
                    <!-- 3. EDITOR CONTEXT - Редактор вопросов -->
                    <Grid x:Name="EditorContext" Visibility="Collapsed" Background="Transparent" Margin="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- TOOLBAR ROW 1: Actions + Search -->
                        <Border Grid.Row="0" Background="#16191F" BorderBrush="#252A36" BorderThickness="0,0,0,1" Padding="20,16" Margin="-16,-16,-16,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnEditorNew" Content="＋ ДОБАВИТЬ" Height="32" Padding="16,0" Margin="0,0,8,0"
                                           Click="BtnEditorNew_Click" Style="{StaticResource SuccessButton}" Cursor="Hand"/>
                                    <Button x:Name="BtnEditorDelete" Content="✕ УДАЛИТЬ" Height="32" Padding="16,0" Margin="0,0,8,0"
                                           Click="BtnEditorDelete_Click" Style="{StaticResource RedButton}" Cursor="Hand"/>
                                    <Button x:Name="BtnEditorLoad" Content="⟳" Height="32" Width="32" Padding="0" Margin="0,0,8,0"
                                           Click="BtnEditorLoad_Click" Style="{StaticResource GhostButton}" Cursor="Hand" ToolTip="Перечитать из SQLite"/>
                                    <Button x:Name="BtnValidateJson" Content="✓ VALIDATE" Height="32" Padding="16,0" Margin="0,0,0,0"
                                           Click="BtnValidateJson_Click" Style="{StaticResource GhostButton}" Cursor="Hand"/>
                                    <TextBlock x:Name="TxtEditorSaveToast" Text="" Foreground="#238636" FontSize="11" FontWeight="Bold"
                                               VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1" x:Name="TxtEditorCount" Text="0 вопросов"
                                           Foreground="#747A8A" FontSize="12" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <Border Grid.Column="2" Background="#0F1115" BorderBrush="#252A36"
                                        BorderThickness="1" CornerRadius="8" Padding="0" Height="32">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🔍" FontSize="12" VerticalAlignment="Center" Margin="12,0,4,0" Opacity="0.5"/>
                                        <TextBox Grid.Column="1" x:Name="TxtEditorSearch" Width="200" Height="30"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="White" Padding="4,0"
                                                VerticalContentAlignment="Center" FontSize="12"
                                                TextChanged="TxtEditorSearch_TextChanged"/>
                                        <Button Grid.Column="2" x:Name="BtnEditorSearchClear" Content="✕" Height="30" Width="30" Padding="0"
                                               Background="Transparent" BorderThickness="0"
                                               Foreground="#747A8A" FontSize="10"
                                               Click="BtnEditorSearchClear_Click" Style="{StaticResource GhostButton}" Cursor="Hand" ToolTip="Очистить поиск"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- TOOLBAR ROW 2: Filter tabs (pill style) -->
                        <Border Grid.Row="1" Background="#16191F" Padding="20,0,20,16" Margin="-16,0,-16,16"
                                BorderBrush="#252A36" BorderThickness="0,0,0,1">
                            <Border Background="#0F1115" BorderBrush="#252A36" BorderThickness="1" CornerRadius="8" Padding="3" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="BtnEditorFilterAll" Content="ВСЕ" Height="26" Width="80"
                                           Click="BtnEditorFilter_Click" Tag="ALL" Style="{StaticResource SegmentedToggleStyle}"/>
                                    <ToggleButton x:Name="BtnEditorFilterMain" Content="РАУНДЫ 1–7" Height="26" Width="100"
                                           Click="BtnEditorFilter_Click" Tag="MAIN" Style="{StaticResource SegmentedToggleStyle}"/>
                                    <ToggleButton x:Name="BtnEditorFilterFinal" Content="ФИНАЛ" Height="26" Width="80"
                                           Click="BtnEditorFilter_Click" Tag="FINAL" Style="{StaticResource SegmentedToggleStyle}"/>
                                </StackPanel>
                            </Border>
                        </Border>

                        <!-- DATA: DataGrid -->
                        <Border Grid.Row="2" Background="#16191F" BorderBrush="#252A36" BorderThickness="1" CornerRadius="12" Padding="0,0,0,8" Margin="0,0,0,16" ClipToBounds="True">
                            <DataGrid x:Name="QuestionsDataGrid"
                                     Background="Transparent"
                                     Foreground="White"
                                     GridLinesVisibility="Horizontal"
                                     HorizontalGridLinesBrush="#1C1F26"
                                     VerticalGridLinesBrush="Transparent"
                                     HeadersVisibility="Column"
                                     AutoGenerateColumns="False"
                                     CanUserAddRows="False" CanUserDeleteRows="False"
                                     CanUserReorderColumns="False" CanUserResizeColumns="True"
                                     CanUserResizeRows="False" CanUserSortColumns="True"
                                     SelectionMode="Single" SelectionUnit="FullRow" FontSize="13"
                                     SelectionChanged="QuestionsDataGrid_SelectionChanged"
                                     RowBackground="Transparent"
                                     AlternatingRowBackground="Transparent"
                                     BorderThickness="0" Margin="0"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#0F1115"/>
                                        <Setter Property="BorderBrush" Value="#252A36"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="Foreground" Value="#A0A5B5"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="10"/>
                                        <Setter Property="Padding" Value="16,12"/>
                                    </Style>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="MinHeight" Value="40"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#264F78"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1C212A"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="16,8"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="60" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#747A8A"/>
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="FontSize" Value="11"/>
                                                <Setter Property="FontFamily" Value="Consolas"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="R" Binding="{Binding Round}" Width="50" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#0A84FF"/>
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="FontSize" Value="12"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="ВОПРОС" Binding="{Binding Text}" Width="*" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="TextWrapping" Value="NoWrap"/>
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="ОТВЕТ" Binding="{Binding Answer}" Width="200" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#E54D4D"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="ДОПУЩЕНИЯ" Binding="{Binding AcceptableAnswers}" Width="160" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#8A91A6"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                <Setter Property="FontStyle" Value="Italic"/>
                                                <Setter Property="FontSize" Value="12"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- FORM: Edit card -->
                        <Border Grid.Row="3" Background="#16191F" BorderBrush="#252A36" BorderThickness="0,1,0,0" Padding="20,16" Margin="-16,0,-16,-16" CornerRadius="0,0,12,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ВОПРОС" FontSize="10" Foreground="#747A8A" FontWeight="Bold" Margin="4,0,0,6"/>
                                    <TextBox x:Name="TxtEditQuestion" Style="{StaticResource EditorTextBoxStyle}" Height="36" FontSize="13" Padding="12,0" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="ОТВЕТ" FontSize="10" Foreground="#E54D4D" FontWeight="Bold" Margin="4,0,0,6"/>
                                    <TextBox x:Name="TxtEditAnswer" Style="{StaticResource EditorTextBoxStyle}" Foreground="#E54D4D" Height="36" FontWeight="Bold" FontSize="13" Padding="12,0" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="ДОПУЩЕНИЯ" FontSize="10" Foreground="#747A8A" FontWeight="Bold" Margin="4,0,0,6"/>
                                    <TextBox x:Name="TxtEditAccept" Style="{StaticResource EditorTextBoxStyle}" Height="36" FontSize="13" Padding="12,0" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="РАУНД" FontSize="10" Foreground="#0A84FF" FontWeight="Bold" Margin="4,0,0,6" HorizontalAlignment="Center"/>
                                    <TextBox x:Name="TxtEditRound" Style="{StaticResource EditorTextBoxStyle}" Height="36" HorizontalContentAlignment="Center" FontSize="14" FontWeight="Bold" MaxLength="1" Padding="0" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <Button x:Name="BtnEditorApply" Grid.Column="8" Content="СОХРАНИТЬ"
                                        Height="36" Padding="24,0" VerticalAlignment="Bottom"
                                        Foreground="White"
                                        FontWeight="Bold" FontSize="12"
                                        Click="BtnEditorApply_Click"
                                        Style="{StaticResource SuccessButton}" Cursor="Hand"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 4. SETTINGS CONTEXT - Настройки -->
                    <Grid x:Name="SettingsContext" Visibility="Collapsed" Background="Transparent" Margin="0">
                        <Border Background="#16191F" BorderBrush="#252A36" BorderThickness="1" CornerRadius="12" Padding="24,24" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="НАСТРОЙКИ СИСТЕМЫ" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>

                                <!-- Язык / Language -->
                                <Border Background="#0F1115" CornerRadius="8" Padding="16,12" Margin="0,0,0,12" 
                                        BorderBrush="#252A36" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Язык интерфейса" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="Переключение языка вопросов и интерфейса оператора" Foreground="#747A8A" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="BtnSettingsLangRU" Content="RU" Width="48" Height="32"
                                                    Click="BtnLangRU_Click" Style="{StaticResource SuccessButton}" Margin="0,0,6,0"/>
                                            <Button x:Name="BtnSettingsLangEN" Content="EN" Width="48" Height="32"
                                                    Click="BtnLangEN_Click" Style="{StaticResource GhostButton}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Пропустить вступление -->
                                <Border Background="#0F1115" CornerRadius="8" Padding="16,12" Margin="0,0,0,12" 
                                        BorderBrush="#252A36" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Пропустить вступление" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="Перейти сразу к первому вопросу, минуя представление игроков" Foreground="#747A8A" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkFastTrack" Grid.Column="1" VerticalAlignment="Center"
                                                  Checked="ChkFastTrack_Changed" Unchecked="ChkFastTrack_Changed"
                                                  Style="{StaticResource ObsidianCheckBox}"/>
                                    </Grid>
                                </Border>

                                <!-- Хронометраж голосования (УСТАРЕЛО, ТЕПЕРЬ ВСЕГДА ИСПОЛЬЗУЕТСЯ POPUP) -->
                                <Border Background="#0F1115" CornerRadius="8" Padding="16,12" Margin="0,0,0,12" 
                                        BorderBrush="#252A36" BorderThickness="1" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="Хронометраж голосования" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="Выберите сценарий голосования после каждого раунда" Foreground="#747A8A" FontSize="11" Margin="0,4,0,12" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="BtnVoteModeExpress" Content="⚡ Экспресс" 
                                                    Height="32" Padding="16,0" Margin="0,0,8,0"
                                                    Click="BtnVoteModeExpress_Click" Style="{StaticResource AccentButton}"/>
                                            <Button x:Name="BtnVoteModeFull" Content="🎬 Полный" 
                                                    Height="32" Padding="16,0"
                                                    Click="BtnVoteModeFull_Click" Style="{StaticResource GhostButton}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtVoteModeDescription" 
                                                   Text="Быстрое голосование без перерыва. Игроки сразу выбирают слабое звено." 
                                                   Foreground="#747A8A" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Подзвучивать события раунда -->
                                <Border Background="#0F1115" CornerRadius="8" Padding="16,12" Margin="0,0,0,12" 
                                        BorderBrush="#252A36" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Подзвучивать события раунда" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="Короткие звуки при нажатии Wrong, Bank, Correct" Foreground="#747A8A" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkRoundSfx" Grid.Column="1" VerticalAlignment="Center"
                                                  Checked="ChkRoundSfx_Changed" Unchecked="ChkRoundSfx_Changed"
                                                  Style="{StaticResource ObsidianCheckBox}"/>
                                    </Grid>
                                </Border>

                                <!-- Громкость -->
                                <Border Background="#0F1115" CornerRadius="8" Padding="16,16" Margin="0,0,0,12" 
                                        BorderBrush="#252A36" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Громкость" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                        <!-- Саундтрек -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🎵 Музыка" Foreground="#747A8A" FontSize="12" VerticalAlignment="Center"/>
                                            <Slider x:Name="SliderMusicVolume" Grid.Column="1" 
                                                    Minimum="0" Maximum="100" Value="100" 
                                                    VerticalAlignment="Center" Margin="12,0"/>
                                            <TextBlock x:Name="TxtMusicVol" Grid.Column="2" Text="100" 
                                                       Foreground="White" FontSize="12" FontWeight="Bold"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <!-- Звуки -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🔊 Звуки" Foreground="#747A8A" FontSize="12" VerticalAlignment="Center"/>
                                            <Slider x:Name="SliderSfxVolume" Grid.Column="1" 
                                                    Minimum="0" Maximum="100" Value="100" 
                                                    VerticalAlignment="Center" Margin="12,0"/>
                                            <TextBlock x:Name="TxtSfxVol" Grid.Column="2" Text="100" 
                                                       Foreground="White" FontSize="12" FontWeight="Bold"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Сброс по умолчанию -->
                                <Button x:Name="BtnResetSettings" Content="⟲ Сбросить настройки" 
                                        Height="36" Margin="0,16,0,0"
                                        Click="BtnResetSettings_Click" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="16,0"/>

                            </StackPanel>
                        </Border>
                    </Grid>

                        </Grid>
                        </Border>
                    </Border>
                </Grid>

                <!-- RIGHT PANEL: Control panel (Bento Box Widget Style) -->
                <Border Grid.Column="2" Background="#0F1115" BorderBrush="#252A36" BorderThickness="1,0,0,0" Margin="0" CornerRadius="0" Panel.ZIndex="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16,24,16,24">
                            
                            <TextBlock x:Name="TxtBroadcastHeader" Text="Пульт режиссера" Foreground="White" FontSize="18" FontWeight="Bold" Margin="4,0,0,24"/>

                            <!-- WIDGET: РАУНД -->
                            <Border Background="#16191F" BorderBrush="#252A36" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBlock Text="⏱" Foreground="{StaticResource ObsidianTextMuted}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Управление раундом" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="1.5*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnStartRound" Grid.Column="0" Height="44" Click="BtnReady_Click" Style="{StaticResource GhostButton}" FontSize="12">
                                            <TextBlock Text="READY" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        </Button>
                                        <Button x:Name="BtnPlay" Grid.Column="2" Height="44" Click="BtnPlay_Click" Style="{StaticResource AccentButton}" FontSize="12">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="▶" Margin="0,0,6,0" Opacity="0.8" VerticalAlignment="Center"/>
                                                <TextBlock Text="START O'CLOCK" HorizontalAlignment="Center" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    
                                    <Button x:Name="BtnNextRound" Content="ЗАВЕРШИТЬ РАУНД" Height="36" Click="BtnNextRound_Click" Style="{StaticResource GhostButton}" FontSize="11" Foreground="#A0A5B5"/>
                                    <Button x:Name="BtnDebugEndRoundTimer" Content="FORCED END" Foreground="White" FontWeight="Bold" Height="32" Margin="0,8,0,0" Click="BtnDebugEndRoundTimer_Click" Style="{StaticResource PurpleButton}" FontSize="10" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <!-- WIDGET: ГРАФИКА БРОДКАСТА -->
                            <Border Background="#16191F" BorderBrush="#252A36" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBlock Text="📺" Foreground="{StaticResource ObsidianTextMuted}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Графика на экранах" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Button x:Name="BtnLogo" Height="40" Margin="0,0,0,20" Click="BtnLogo_Click" Style="{StaticResource GhostButton}" ToolTip="ВКЛ/ВЫКЛ ЛОГОТИП НА ЭКРАНАХ">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="/Assets/Images/logotipka.png" Height="16" Margin="0,0,8,0" Stretch="Uniform"/>
                                            <TextBlock Text="ЛОГОТИП" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    
                                    <TextBlock Text="СТИЛЬ ОФОРМЛЕНИЯ" Foreground="#747A8A" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <!-- Segmented Control for Style -->
                                    <Border Background="#0F1115" BorderBrush="#252A36" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,0,20">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton x:Name="BtnStyleClassic" Grid.Column="0" Content="CLASSIC" Height="32" Click="BtnBcStyleClassic_Click" Style="{StaticResource SegmentedToggleStyle}"/>
                                            <ToggleButton x:Name="BtnStyleNew" Grid.Column="1" Content="PREMIUM" Height="32" Click="BtnBcStyleNew_Click" Style="{StaticResource SegmentedToggleStyle}" IsChecked="True"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="ЭЛЕМЕНТЫ РАУНДА" Foreground="#747A8A" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <Border Background="#0F1115" BorderBrush="#252A36" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,0,20">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton x:Name="TglBcTimer" Grid.Column="0" Content="ТАЙМЕР" Height="32" Click="TglBcTimer_Click" Style="{StaticResource SegmentedToggleStyle}"/>
                                            <ToggleButton x:Name="TglBcChain" Grid.Column="1" Content="ЦЕПОЧКА" Height="32" Click="TglBcChain_Click" Style="{StaticResource SegmentedToggleStyle}"/>
                                            <ToggleButton x:Name="TglBcChainTimer" Grid.Column="2" Content="ОБА" Height="32" Click="TglBcChainTimer_Click" Style="{StaticResource SegmentedToggleStyle}"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="ОВЕРЛЕИ" Foreground="#747A8A" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <UniformGrid Columns="2">
                                        <ToggleButton x:Name="TglBcBank" Content="БАНК" Height="36" Margin="0,0,4,0" FontWeight="Bold" FontSize="11" Click="TglBcBank_Click" Style="{StaticResource FlatToggleStyle}"/>
                                        <ToggleButton x:Name="TglBcDuel" Content="ДУЭЛЬ" Height="36" Margin="4,0,0,0" FontWeight="Bold" FontSize="11" Click="TglBcDuel_Click" Style="{StaticResource FlatToggleStyle}"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- WIDGET: PRE-GAME -->
                            <Border x:Name="PreGameButtons" Background="#16191F" BorderBrush="#252A36" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16" IsEnabled="False" Opacity="0.5">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBlock Text="🎬" Foreground="{StaticResource ObsidianTextMuted}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Pre-Game &amp; Intro" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <Button x:Name="BtnOpeningUI" Content="OPENING" Height="40" Margin="0,0,0,12" FontWeight="Bold" FontSize="12" Click="BtnOpening_Click" Style="{StaticResource AccentButton}"/>
                                    
                                    <UniformGrid Columns="3">
                                        <Button x:Name="BtnIntro1UI" Content="INTRO 1" Height="34" Margin="0,0,4,0" FontWeight="SemiBold" FontSize="10" Click="BtnIntro1_Click" Style="{StaticResource GhostButton}"/>
                                        <Button x:Name="BtnIntro2UI" Content="INTRO 2" Height="34" Margin="2,0,2,0" FontWeight="SemiBold" FontSize="10" Click="BtnIntro2_Click" Style="{StaticResource GhostButton}"/>
                                        <Button x:Name="BtnRulesUI" Content="RULES" Height="34" Margin="4,0,0,0" FontWeight="SemiBold" FontSize="10" Click="BtnRulesIntro_Click" Style="{StaticResource GhostButton}"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- WIDGET: СЕРВИС (border-glow 098cce1e98) -->
                            <Border Background="#16191F" BorderBrush="#252A36" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#252A36" BlurRadius="8" ShadowDepth="0" Opacity="0.15"/>
                                </Border.Effect>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource StudioAccent}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Сервис" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <UniformGrid Columns="2">
                                        <Button x:Name="BtnStopAudio" Content="STOP AUDIO" Height="36" Margin="0,0,4,8" Click="BtnStopAudio_Click" Style="{StaticResource GhostButton}" FontSize="10" Foreground="#E54D4D"/>
                                        <Button x:Name="BtnRestartRound" Content="RESTART" Height="36" Margin="4,0,0,8" Click="BtnRestartRound_Click" Style="{StaticResource GhostButton}" FontSize="10"/>
                                    </UniformGrid>
                                    
                                    <Button x:Name="BtnCloseSession" Content="CLOSE SESSION" Height="36" Margin="0,0,0,16" Click="BtnCloseSession_Click" Style="{StaticResource DangerGhostButton}" FontSize="10" FontWeight="SemiBold"/>
                                    
                                    <Button x:Name="BtnFilmResetVoting" Content="СБРОСИТЬ ГОЛОСОВАНИЕ" Height="36" Margin="0,0,0,8"
                                            IsEnabled="False" Click="BtnFilmResetVoting_Click"
                                            Style="{StaticResource DangerGhostButton}" FontSize="10" FontWeight="Bold"
                                            ToolTip="Вернуть к моменту до ОТБИВКА"/>
                                    <Border BorderBrush="#E54D4D" BorderThickness="1" CornerRadius="8" Padding="0" Margin="0,4,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#E54D4D" BlurRadius="10" ShadowDepth="0" Opacity="0.2"/>
                                        </Border.Effect>
                                        <Button x:Name="BtnPanic" Content="! ПАНИКА !" Height="44" FontWeight="Black" FontSize="13" Click="BtnPanic_Click" Style="{StaticResource RedButton}" Margin="0"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ═══ ОВЕРЛЕЙ: УЧАСТНИКИ (по центру экрана) ═══ -->
            <Border x:Name="ParticipantsOverlay" Grid.Row="0" Grid.RowSpan="5" Panel.ZIndex="200"
                    Background="#CC0D1117" Visibility="Collapsed"
                    MouseLeftButtonDown="ParticipantsOverlay_BackgroundClick">
                <Border Background="{StaticResource ObsidianSurface}" CornerRadius="{DynamicResource CornerRadiusPill}" BorderBrush="{StaticResource ObsidianBorderStrong}" BorderThickness="1"
                        MaxWidth="800" MaxHeight="600" 
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="28,24,28,24" MouseLeftButtonDown="ParticipantsOverlay_CardClick">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Заголовок -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="👥 Участники шоу" Foreground="{StaticResource ObsidianText}" FontSize="{DynamicResource FontSizeHeader}" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Content="✕" HorizontalAlignment="Right" 
                                    Width="36" Height="36" FontSize="18"
                                    Background="Transparent" Foreground="{StaticResource ObsidianTextSecondary}" 
                                    BorderThickness="0" Cursor="Hand" Margin="0,-4,-4,0"
                                    Click="BtnCloseParticipants_Click" Style="{StaticResource FlatButton}"/>
                        </Grid>
                        <!-- Сетка участников -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ParticipantsGrid" ItemsSource="{Binding}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource ObsidianCard}" CornerRadius="{DynamicResource CornerRadiusRound}" Padding="12" Margin="6" 
                                                BorderBrush="{StaticResource ObsidianBorderStrong}" BorderThickness="1" Cursor="Hand">
                                            <StackPanel HorizontalAlignment="Center">
                                                <!-- Фото -->
                                                <Border Width="90" Height="90" CornerRadius="{DynamicResource CornerRadiusMedium}" 
                                                        Background="{StaticResource ObsidianBorderStrong}" BorderThickness="0"
                                                        ClipToBounds="True" Margin="0,0,0,8"
                                                        MouseLeftButtonDown="PlayerPhoto_Click"
                                                        ToolTip="Нажмите для загрузки фото">
                                                    <Grid>
                                                        <TextBlock Text="📷" FontSize="{DynamicResource FontSizeGameQuestion}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource ObsidianTextDisabled}"/>
                                                        <Image Source="{Binding PhotoSource}" Stretch="UniformToFill" Width="90" Height="90"/>
                                                    </Grid>
                                                </Border>
                                                <!-- Имя -->
                                                <TextBlock Foreground="{StaticResource ObsidianText}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold" 
                                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="120">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding GameName}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding GameName}" Value="">
                                                                    <Setter Property="Text" Value="{Binding ConsoleDisplay}"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource ObsidianTextDisabled}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding GameName}" Value="{x:Null}">
                                                                    <Setter Property="Text" Value="{Binding ConsoleDisplay}"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource ObsidianTextDisabled}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <!-- Город/профессия -->
                                                <TextBlock Text="{Binding CityDesc}" Foreground="{StaticResource ObsidianTextDisabled}" FontSize="{DynamicResource FontSizeXXXSmall}" 
                                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Border>

            <!-- Code-behind write targets: referenced in state handlers, will be promoted to visible UI -->
            <Grid Visibility="Collapsed">
                <Button x:Name="BtnIntro1"/><Button x:Name="BtnIntro2"/><Button x:Name="BtnNextQuestion"/>
                <Button x:Name="BtnOpening"/><Button x:Name="BtnIncorrect"/><Button x:Name="BtnRulesIntro"/>
                <DataGrid x:Name="PlayersGrid"><DataGrid.Columns><DataGridTextColumn x:Name="VotedForColumn"/></DataGrid.Columns></DataGrid>
                <StackPanel x:Name="PreGamePanel"/><TextBlock x:Name="RemoteLinkText"/>
                <Border x:Name="RoundBankPanel"/><TextBlock x:Name="StartingPlayerTextBlock"/>
                <Border x:Name="StatusBarBorder"/><StackPanel x:Name="TimerPanel"/>
                <TextBlock x:Name="TxtGameState"/><TextBlock x:Name="TxtRound"/>
                <TextBlock x:Name="TxtRoundBank"/><TextBlock x:Name="TxtStatusAction"/>
                <TextBlock x:Name="TxtStatusHint"/><TextBlock x:Name="TxtStatusProcess"/>
                <TextBlock x:Name="TxtTimerLabel"/><TextBlock x:Name="TxtRoundNumber"/>
                <Button x:Name="BtnBotTurn"/><ToggleButton x:Name="TglAutoBot"/>
                <Button x:Name="BtnBotGameSemiAuto"/><Button x:Name="BtnBotGameAuto"/>
             </Grid>

            <!-- ОВЕРЛЕЙ: Терминал логов (перекрывает, не сдвигает) -->
                    <Border x:Name="LogContainer" Grid.Row="3" VerticalAlignment="Bottom" Panel.ZIndex="100"
                    Background="#0F1115" 
                    BorderBrush="{StaticResource ObsidianBorder}" BorderThickness="0,1,0,0"
                    MaxHeight="200" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="ЛОГ СОБЫТИЙ" Foreground="#5a6" FontSize="{DynamicResource FontSizeSmall}" FontFamily="Consolas" FontWeight="Bold" Margin="10,5,0,3"/>
                    <ListBox Grid.Row="1" x:Name="LstLog" 
                             Background="#0F1115" 
                             Foreground="{StaticResource ObsidianTextSecondary}" 
                             BorderThickness="0" Padding="10,2" Margin="0"
                             FontFamily="Consolas" FontSize="{DynamicResource FontSizeSmall}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.Resources>
                            <Style TargetType="ScrollBar">
                                <Setter Property="OverridesDefaultStyle" Value="True"/>
                                <Setter Property="Width" Value="8"/>
                                <Setter Property="MinWidth" Value="8"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollBar">
                                            <Grid Background="Transparent">
                                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                    <Track.Thumb>
                                                        <Thumb>
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="Thumb">
                                                                    <Border x:Name="tb" Background="{StaticResource ObsidianBorderStrong}" CornerRadius="{DynamicResource CornerRadiusStandard}"/>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="tb" Property="Background" Value="{StaticResource ObsidianBorderLight}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                    </Track.Thumb>
                                                </Track>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="Orientation" Value="Horizontal">
                                        <Setter Property="Width" Value="Auto"/>
                                        <Setter Property="Height" Value="8"/>
                                        <Setter Property="MinHeight" Value="8"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ScrollBar">
                                                    <Grid Background="Transparent">
                                                        <Track x:Name="PART_Track" IsDirectionReversed="False">
                                                            <Track.Thumb>
                                                                <Thumb>
                                                                    <Thumb.Template>
                                                                        <ControlTemplate TargetType="Thumb">
                                                                            <Border x:Name="tb" Background="{StaticResource ObsidianBorderStrong}" CornerRadius="{DynamicResource CornerRadiusStandard}"/>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="tb" Property="Background" Value="{StaticResource ObsidianBorderLight}"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Thumb.Template>
                                                                </Thumb>
                                                            </Track.Thumb>
                                                        </Track>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Resources>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="2,1"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        </Grid>

    <!-- ═══ ОВЕРЛЕЙ: ДОСЬЕ УЧАСТНИКА (root level) ═══ -->
    <Border x:Name="DossierOverlay" Grid.RowSpan="3" Panel.ZIndex="300"
            Background="#E6050911" Visibility="Collapsed"
            MouseLeftButtonDown="DossierOverlay_BackgroundClick">
        <Border Background="#16191F" CornerRadius="{DynamicResource CornerRadiusPill}" BorderBrush="{StaticResource ObsidianBorderStrong}" BorderThickness="1"
                Width="500" HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="28" MouseLeftButtonDown="DossierOverlay_CardClick">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Title + Close -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="Досье участника" Foreground="{StaticResource ObsidianText}" FontSize="{DynamicResource FontSizeHeader}" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Content="✕" HorizontalAlignment="Right" Width="32" Height="32" FontSize="{DynamicResource FontSizeSubheader}"
                            Background="Transparent" Foreground="{StaticResource ObsidianTextSecondary}" BorderThickness="0" Cursor="Hand"
                            Click="BtnCloseDossier_Click" Style="{StaticResource FlatButton}"/>
                </Grid>

                <!-- Row 1: Photo (left) + Name (right) — Teams style -->
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Photo square with "Изменить" overlay -->
                    <Border Grid.Column="0" Width="130" Height="130" CornerRadius="{DynamicResource CornerRadiusRound}" 
                            Background="{StaticResource ObsidianRaised}" BorderBrush="{StaticResource ObsidianBorderLight}" BorderThickness="1"
                            ClipToBounds="True" Margin="0,0,16,0" Cursor="Hand"
                            MouseLeftButtonDown="PlayerPhoto_Click"
                            ToolTip="Нажмите для загрузки фото">
                        <Grid>
                            <TextBlock x:Name="CropHintText" Text="📷" FontSize="{DynamicResource FontSizeDisplay}" HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" Foreground="{StaticResource ObsidianTextMuted}"/>
                            <Image x:Name="DossierPhotoImage" Stretch="UniformToFill"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.RenderTransform><TranslateTransform x:Name="CropTransform" X="0" Y="0"/></Image.RenderTransform>
                            </Image>
                            <!-- "Изменить" button overlay at bottom -->
                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                    Background="{StaticResource ColorInfo}" CornerRadius="{DynamicResource CornerRadiusStandard}" Padding="10,3" Margin="0,0,0,6"
                                    Cursor="Hand" MouseLeftButtonDown="BtnDossierUploadPhoto_Click">
                                <TextBlock Text="Изменить" Foreground="White" FontSize="{DynamicResource FontSizeXSmall}" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Name field with accent underline -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Игровое имя" Foreground="{StaticResource ObsidianTextDisabled}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,0,4"/>
                        <TextBox x:Name="DossierGameName" Background="Transparent" Foreground="White" 
                                 BorderThickness="0" FontSize="{DynamicResource FontSizeGameAction}" FontWeight="Bold" Padding="0,4"
                                 Style="{StaticResource ObsidianTextBox}"/>
                        <Border Height="2" Background="{StaticResource ColorTeams}" CornerRadius="{DynamicResource CornerRadiusSmall}" Margin="0,2,0,0"/>
                        <TextBlock Text="ФИО" Foreground="{StaticResource ObsidianTextDisabled}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,14,0,4"/>
                        <TextBox x:Name="DossierFullName" Background="Transparent" Foreground="{StaticResource ObsidianTextPrimary}" 
                                 BorderThickness="0" FontSize="{DynamicResource FontSizeSubheader}" Padding="0,4"
                                 Style="{StaticResource ObsidianTextBox}"/>
                        <Border Height="1" Background="{StaticResource ObsidianBorderStrong}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Row 2: City + Age + Пульт -->
                <Grid Grid.Row="2" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Город / Профессия" Foreground="{StaticResource ObsidianTextDisabled}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,0,4"/>
                        <TextBox x:Name="DossierCityDesc" Background="#16191F" Foreground="{StaticResource ObsidianTextSecondary}" 
                                 FontSize="{DynamicResource FontSizeBody}" 
                                 Style="{StaticResource PremiumTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Возраст" Foreground="{StaticResource ObsidianTextDisabled}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,0,4"/>
                        <TextBox x:Name="DossierAge" Background="#16191F" Foreground="{StaticResource ObsidianTextSecondary}" 
                                 FontSize="{DynamicResource FontSizeBody}"
                                 TextAlignment="Center" Style="{StaticResource PremiumTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Пульт №" Foreground="{StaticResource ColorTeams}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="DossierPultNumber" Background="#16191F" Foreground="{StaticResource ColorTeams}" 
                                 FontSize="{DynamicResource FontSizeBody}"
                                 TextAlignment="Center" FontWeight="Bold" Style="{StaticResource PremiumTextBox}"/>
                    </StackPanel>
                </Grid>

                <!-- Row 3: Bio -->
                <StackPanel Grid.Row="3" Margin="0,0,0,10">
                    <TextBlock Text="Био / Интересный факт" Foreground="{StaticResource ObsidianTextDisabled}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,0,4"/>
                    <TextBox x:Name="DossierBio" Background="#16191F" Foreground="{StaticResource ObsidianTextSecondary}" 
                             FontSize="{DynamicResource FontSizeSmall}" 
                             Height="70" TextWrapping="Wrap" AcceptsReturn="True" 
                             VerticalScrollBarVisibility="Auto" Style="{StaticResource PremiumTextBox}"/>
                </StackPanel>

                <!-- Row 7: Bottom buttons — Teams style -->
                <Grid Grid.Row="7" Margin="0,12,0,0">
                    <Button Content="‹  Назад" HorizontalAlignment="Left" 
                            Background="Transparent" Foreground="{StaticResource ObsidianTextSecondary}" FontSize="{DynamicResource FontSizeBody}" 
                            BorderThickness="0" Cursor="Hand" Padding="0"
                            Click="BtnCloseDossier_Click" Style="{StaticResource FlatButton}"/>
                    <Button Content="✓  Сохранить" HorizontalAlignment="Right" 
                            Background="{StaticResource ColorTeams}" Foreground="White" FontSize="{DynamicResource FontSizeBody}" FontWeight="Bold"
                            Padding="20,8" Cursor="Hand"
                            Click="BtnSaveDossier_Click" Style="{StaticResource FlatButton}"/>
                </Grid>
            </Grid>
        </Border>
    </Border>


        <!-- Row 2: Modern Status Bar with gradient -->
        <Border Grid.Row="2" BorderBrush="Transparent" BorderThickness="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#005A9E" Offset="0"/>
                    <GradientStop Color="#007ACC" Offset="0.5"/>
                    <GradientStop Color="#1177BB" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Border Background="#20FFFFFF" CornerRadius="8" Padding="6,1" Margin="0,0,8,0">
                        <TextBlock Text="LIVE" Foreground="#90EE90" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TxtStatusBarInfo" Text="Weakest Link — Operator" 
                               Foreground="White" FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="BtnToggleLogs" Click="BtnToggleLogs_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Stretch"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Padding="10,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#20FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#15FFFFFF" CornerRadius="6" Padding="6,2" Margin="0,0,0,0">
                            <TextBlock x:Name="TxtLogToggleLabel" Text="[&gt;_] Логи" 
                                       Foreground="#FFFFFFDD" FontSize="10" FontFamily="Consolas"/>
                        </Border>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
