                                        <Grid Width="100" Height="100" HorizontalAlignment="Center">
                                            <!-- Circular progress ring (4707a76a) -->
                                            <Ellipse Stroke="#252A36" StrokeThickness="2" Fill="Transparent"/>
                                            <Ellipse Stroke="{StaticResource StudioAccent}" StrokeThickness="2" Fill="Transparent" Opacity="0.85" Margin="2">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect Color="#14B8A6" BlurRadius="6" ShadowDepth="0" Opacity="0.2"/>
                                                </Ellipse.Effect>
