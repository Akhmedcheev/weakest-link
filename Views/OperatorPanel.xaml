                                           HorizontalAlignment="Center" Margin="0,16,0,8"/>
                                           
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="BankChainList" HorizontalAlignment="Stretch" Margin="16,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Background}" CornerRadius="8" Margin="0,3" Padding="0,10"
                                                        BorderBrush="#252A36" BorderThickness="1">
