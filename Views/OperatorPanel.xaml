                                                    Foreground="White"
                                                    FontSize="12" FontWeight="Bold" Height="44"
                                                    Margin="0,0,12,0" MinWidth="160" Padding="24,0"
                                                    Click="BtnRosterDone_Click" Style="{StaticResource AccentButton}">
                                            </Button>

                                            <Button x:Name="BtnStartSession" Height="44"
                                                    Foreground="#FFFFFF" 
                                                    FontSize="13" FontWeight="Bold"
