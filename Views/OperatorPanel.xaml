<Window x:Class="WeakestLink.Views.OperatorPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Слабое Звено — Панель оператора" 
        Height="{DynamicResource WindowDefaultHeight}" 
        Width="{DynamicResource WindowDefaultWidth}"
        Background="{StaticResource ObsidianAppBg}" 
        Foreground="{DynamicResource ObsidianTextPrimary}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="{DynamicResource TitleBarHeight}" ResizeBorderThickness="6" CornerRadius="{DynamicResource CornerRadiusNone}" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/ObsidianStyles.xaml"/>
                <ResourceDictionary Source="Styles/UIConstants.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <!-- Discord Scrollbar: Vertical -->
        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DiscordScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="MinHeight" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource DiscordScrollThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource ObsidianSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource ObsidianTextPrimary}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{StaticResource ObsidianBorder}" BorderThickness="0,0,0,1">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource ObsidianRaised}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource ObsidianBorderLight}"/>
                                <Setter Property="Foreground" Value="{StaticResource ObsidianTextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#16191F"/>
            <Setter Property="Foreground" Value="{StaticResource ObsidianTextPrimary}"/>
            <Setter Property="BorderBrush" Value="#252A36"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource PremiumComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Grid.Column="2" Focusable="false" 
                                          IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="TkBorder" Background="#16191F" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                            <Path x:Name="Arrow" Fill="{StaticResource ObsidianTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Data="M0,0 L4,4 L8,0 Z"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TkBorder" Property="BorderBrush" Value="{StaticResource ObsidianBorderLight}"/>
                                                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource ObsidianTextPrimary}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="TkBorder" Property="Background" Value="{StaticResource ObsidianRaised}"/>
                                                <Setter TargetName="TkBorder" Property="BorderBrush" Value="{StaticResource ObsidianBorderLight}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ToggleButton.Background>
                                    <TemplateBinding Property="Background"/>
                                </ToggleButton.Background>
                                <ToggleButton.BorderBrush>
                                    <TemplateBinding Property="BorderBrush"/>
                                </ToggleButton.BorderBrush>
                                <ToggleButton.BorderThickness>
                                    <TemplateBinding Property="BorderThickness"/>
                                </ToggleButton.BorderThickness>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="10,0,25,0" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#16191F" BorderThickness="1" BorderBrush="#252A36" CornerRadius="0,0,8,8" />
                                    <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ObsidianSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource ObsidianTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ObsidianBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource CornerRadiusStandard}">
                            <ContentPresenter x:Name="content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource ObsidianRaised}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource ObsidianBorderLight}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Dark Menu: корневое меню ═══ -->
        <Style TargetType="Menu">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ObsidianTextPrimary}"/>
        </Style>

        <!-- ═══ Dark MenuItem: полный шаблон ═══ -->
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ObsidianTextPrimary}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <!-- Корневой бордер элемента -->
                            <Border x:Name="Border" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIconColumnGroup"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIGTColumnGroup"/>
                                        <ColumnDefinition Width="14"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Иконка / чекмарк -->
                                    <ContentPresenter x:Name="Icon" Grid.Column="0" 
                                                      ContentSource="Icon" 
                                                      VerticalAlignment="Center" Margin="0,0,6,0"
                                                      Width="16" Height="16"/>

                                    <!-- Текст -->
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" 
                                                      RecognizesAccessKey="True" 
                                                      VerticalAlignment="Center"
                                                      TextBlock.Foreground="{TemplateBinding Foreground}"/>

                                    <!-- Горячие клавиши -->
                                    <TextBlock x:Name="IGTHost" Grid.Column="2" 
                                               Text="{TemplateBinding InputGestureText}" 
                                               Foreground="{StaticResource ObsidianTextSecondary}" FontSize="{DynamicResource FontSizeCaption}"
                                               Margin="20,0,0,0" VerticalAlignment="Center"/>

                                    <!-- Стрелка подменю -->
                                    <Path x:Name="SubMenuArrow" Grid.Column="3" 
                                          Fill="{StaticResource ObsidianTextMuted}" VerticalAlignment="Center" 
                                          Data="M0,0 L4,3.5 L0,7 Z" Visibility="Collapsed"/>
                                </Grid>
                            </Border>

                            <!-- Выпадающее подменю (popup) -->
                            <Popup x:Name="PART_Popup" 
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                                   Placement="Bottom" AllowsTransparency="True" Focusable="False" 
                                   PopupAnimation="Fade" HorizontalOffset="-2">
                                <Border Background="{StaticResource ObsidianCard}" BorderBrush="{StaticResource ObsidianBorderLight}" BorderThickness="1" 
                                        CornerRadius="{DynamicResource CornerRadiusSmall}" Padding="0,4" SnapsToDevicePixels="True">
                                    <ScrollViewer CanContentScroll="True" 
                                                  VerticalScrollBarVisibility="Auto"
                                                  Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly={x:Type FrameworkElement}}}">
                                        <StackPanel IsItemsHost="True" 
                                                    KeyboardNavigation.DirectionalNavigation="Cycle"
                                                    Grid.IsSharedSizeScope="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Подменю: стрелка видна -->
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="SubMenuArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Right"/>
                            </Trigger>
                            <!-- Элемент подменю (без вложенных) -->
                            <Trigger Property="Role" Value="SubmenuItem">
                                <Setter TargetName="SubMenuArrow" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <!-- Hover -->
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource ObsidianRaised}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <!-- Нажатие (открытие подменю из TopLevel) -->
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource ObsidianSurface}"/>
                            </Trigger>
                            <!-- Disabled -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource ObsidianTextDisabled}"/>
                            </Trigger>
                            <!-- Скрыть иконку если нет -->
                            <Trigger Property="Icon" Value="{x:Null}">
                                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Dark Separator в меню ═══ -->
        <Style TargetType="Separator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource ObsidianBorder}"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{TemplateBinding Background}" 
                                Height="{TemplateBinding Height}" 
                                Margin="{TemplateBinding Margin}" 
                                SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        </ResourceDictionary>
    </Window.Resources>
    
    <!-- Outer wrapper: Title bar + Content + Status bar -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="22"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Cursor-style Title Bar -->
        <Border Grid.Row="0" Background="#16191F" BorderBrush="{StaticResource ObsidianBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Logo + Brand (compact) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,16,0">
                    <Image Source="/Assets/Images/logotipka.png" Width="18" Height="18" Stretch="Uniform" 
                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,8,0"/>
                    <TextBlock Text="Слабое Звено" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ObsidianTextSecondary}" 
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" — " FontSize="11" Foreground="{StaticResource ObsidianTextMuted}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTitleBarMode" Text="Оператор" FontSize="11" Foreground="{StaticResource ObsidianTextMuted}" 
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Session Status (dot + text) -->
                <Border x:Name="TitleSessionPill" Grid.Column="1" Background="Transparent" Padding="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0">
                        <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <SolidColorBrush x:Name="TitleSessionDot" Color="#4D4D4D"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock x:Name="TxtTitleSession" Text="СЕССИЯ НЕАКТИВНА" FontSize="10" 
                                   Foreground="#4D4D4D" FontWeight="Normal" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- RIGHT: Utility Icons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                    <Button x:Name="BtnTitleQR" Content="&#xE8B9;" ToolTip="QR-код для подключения"
                            FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource ObsidianTextMuted}"
                            Padding="7,3" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource FlatButton}"/>
                    <Button x:Name="BtnTakeSelfie" Content="&#xE722;" ToolTip="Скриншот (Ctrl+Q)"
                            FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource ObsidianTextMuted}"
                            Padding="7,3" Margin="1,0,0,0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="BtnTakeSelfie_Click" Style="{StaticResource FlatButton}"/>
                    <Button x:Name="BtnTitleSettings" Content="&#xE713;" ToolTip="Настройки"
                            FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource ObsidianTextMuted}"
                            Padding="7,3" Margin="1,0,0,0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnTitleSettings_Click" Style="{StaticResource FlatButton}"/>

                    <ToggleButton x:Name="TglExtendedMode" ToolTip="Расширенный режим"
                                  FontFamily="Segoe MDL2 Assets" FontSize="13" 
                                  Padding="7,3" Margin="1,0,0,0" 
                                  Background="Transparent" BorderThickness="0" Cursor="Hand"
                                  WindowChrome.IsHitTestVisibleInChrome="True"
                                  Click="TglExtendedMode_Click" Style="{StaticResource FlatToggleStyle}">
                        <ToggleButton.Content>
                            <TextBlock Text="&#xE72D;" Foreground="{StaticResource ObsidianTextMuted}"/>
                        </ToggleButton.Content>
                    </ToggleButton>
                </StackPanel>

                <!-- RIGHT: Window Controls (Cursor-style) -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Stretch" Margin="0">
                    <Button x:Name="BtnTitleMinimize" ToolTip="Свернуть"
                            Style="{StaticResource WindowControlButton}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="BtnTitleMinimize_Click">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="BtnTitleMaximize" ToolTip="Развернуть"
                            Style="{StaticResource WindowControlButton}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="BtnTitleMaximize_Click">
                        <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="BtnTitleClose" ToolTip="Закрыть"
                            Style="{StaticResource WindowCloseButton}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="BtnTitleClose_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: App Content -->
        <Grid Grid.Row="1" x:Name="RootLayoutGrid" Background="#0F1115">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- COLUMN 0: Activity Bar (modern icon strip with glow) -->
        <Border Grid.Column="0" Background="#0F1115" 
                BorderBrush="{StaticResource ObsidianBorder}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <!-- Hidden language buttons (used by code-behind) -->
                <StackPanel DockPanel.Dock="Bottom" Visibility="Collapsed">
                    <Button x:Name="BtnLangRU" Click="BtnLangRU_Click"/>
                    <Button x:Name="BtnLangEN" Click="BtnLangEN_Click"/>
                </StackPanel>

                <!-- Hidden text references for localization code-behind -->
                <StackPanel Visibility="Collapsed">
                    <TextBlock x:Name="TxtNavLabel" Text="НАВИГАЦИЯ"/>
                    <TextBlock x:Name="TxtStatsLabel" Text="СТАТИСТИКА"/>
                    <TextBlock x:Name="NavTxtSetup" Text="Лобби"/>
                    <TextBlock x:Name="NavTxtPlay" Text="Игра"/>
                    <TextBlock x:Name="NavTxtStats" Text="Аналитика"/>
                    <TextBlock x:Name="NavTxtEditor" Text="Редактор"/>
                </StackPanel>

                <!-- Navigation icons -->
                <StackPanel VerticalAlignment="Top" Margin="0,4,0,0">

                    <!-- Lobby -->
                    <Button x:Name="NavBtnSetup" Tag="SETUP" Style="{StaticResource NavButtonStyleActive}"
                            Content="&#xE80F;" ToolTip="Лобби" Click="NavBtn_Click"/>

                    <!-- Play -->
                    <Button x:Name="NavBtnPlay" Tag="PLAY" Style="{StaticResource NavButtonStyle}"
                            Content="&#xE768;" ToolTip="Игра" Click="NavBtn_Click"/>

                    <!-- Analytics -->
                    <Button x:Name="NavBtnStats" Tag="STATS" Style="{StaticResource NavButtonStyle}"
                            Content="&#xE9D9;" ToolTip="Аналитика" Click="NavBtn_Click"/>

                    <!-- Editor -->
                    <Button x:Name="NavBtnEditor" Tag="EDIT" Style="{StaticResource NavButtonStyle}"
                            Content="&#xE70F;" ToolTip="Редактор" Click="NavBtn_Click"/>

                </StackPanel>

                <!-- Hidden named elements for code-behind compatibility (all collapsed) -->
                <StackPanel Visibility="Collapsed">
                    <TextBlock x:Name="TxtBankLabel" Text="БАНК"/>
                    <TextBlock x:Name="TxtCurrentBank_Side" Text="0"/>
                    <TextBlock x:Name="TxtTotalLabel" Text="ОБЩИЙ"/>
                    <TextBlock x:Name="TxtTotalBank_Side" Text="0"/>
                    <TextBlock x:Name="TxtTimeLabel" Text="ВРЕМЯ"/>
                    <TextBlock x:Name="TxtTimer_Side" Text="00:00"/>
                    <TextBlock x:Name="TxtRoundLabel" Text="РАУНД"/>
                    <TextBlock x:Name="TxtRoundNumber_Side" Text="—"/>
                    <TextBlock x:Name="TxtQuestionLabel" Text="ВОПРОС"/>
                    <TextBlock x:Name="TxtQuestionCount_Side" Text="0/0"/>
                    <TextBlock x:Name="TxtRoundStatusLabel" Text="РАУНДЫ"/>
                    <StackPanel x:Name="RoundStatusIcons" Orientation="Horizontal">
                        <Border x:Name="RoundIcon1"><TextBlock Text="1"/></Border>
                        <Border x:Name="RoundIcon2"><TextBlock Text="2"/></Border>
                        <Border x:Name="RoundIcon3"><TextBlock Text="3"/></Border>
                        <Border x:Name="RoundIcon4"><TextBlock Text="4"/></Border>
                        <Border x:Name="RoundIcon5"><TextBlock Text="5"/></Border>
                        <Border x:Name="RoundIcon6"><TextBlock Text="6"/></Border>
                        <Border x:Name="RoundIcon7"><TextBlock Text="7"/></Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtPlayerListLabel" Text="ИГРОКИ"/>
                    <ItemsControl x:Name="PlayerListItems"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- COLUMN 1: ОСНОВНОЙ КОНТЕНТ -->
        <Grid Grid.Column="1" Background="#0F1115">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0: Верхнее меню (Debug) -->
                <RowDefinition Height="Auto"/> <!-- 1: Панель статуса (Банк, Таймер) -->
                <RowDefinition Height="Auto"/> <!-- 2: Статус действия (Вы сделали) -->
                <RowDefinition Height="*"/>    <!-- 3: Рабочая область (Лево, Центр, Право) -->
            </Grid.RowDefinitions>

            <!-- Парящая панель инструментов (overlay слева) -->
            <Border x:Name="ServiceSidePanel" Grid.RowSpan="4" Width="250" 
                        HorizontalAlignment="Left" VerticalAlignment="Stretch"
                        Background="{StaticResource StudioCardBg}" 
                        BorderBrush="{StaticResource StudioCardBorder}" BorderThickness="1,0,1,0"
                        Panel.ZIndex="100" Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="-2" Direction="270" Opacity="0.15"/>
                    </Border.Effect>
                    <DockPanel Margin="12,8">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="14" 
                                           Foreground="{StaticResource StudioAccent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="ИНСТРУМЕНТЫ" 
                                           Foreground="{StaticResource StudioTextMuted}" FontSize="{DynamicResource FontSizeXSmall}" FontWeight="Bold" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Style="{StaticResource FlatButton}"
                                    FontSize="12" Padding="6,2"
                                    Click="BtnCloseToolbar_Click" ToolTip="Закрыть панель"/>
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- === ЭКРАНЫ (перенесены из правой панели) === -->
                            <TextBlock Text="ЭКРАНЫ" Foreground="{StaticResource ObsidianAccentTeal}" FontSize="{DynamicResource FontSizeXSmall}" FontWeight="Bold" Margin="0,0,0,4"/>
                            <Button x:Name="BtnScreenPremium" Content="ЭКРАН ВЕДУЩЕГО (OLD)" Height="26" Margin="0,0,0,3" FontSize="{DynamicResource FontSizeXXXSmall}"
                                    Background="{StaticResource ColorInfo}" Foreground="White"
                                    BorderBrush="Transparent" BorderThickness="2"
                                    Click="BtnOpenHostPremium_Click" Style="{StaticResource FlatButton}"/>
                            <Button x:Name="BtnScreenModPremium" Content="ЭКРАН ВЕДУЩЕГО (NEW)" Height="26" Margin="0,0,0,3" FontSize="{DynamicResource FontSizeXXXSmall}"
                                    Background="{StaticResource ColorInfo}" Foreground="White"
                                    BorderBrush="Transparent" BorderThickness="2"
                                    Click="BtnOpenHostModernPremium_Click" Style="{StaticResource FlatButton}"/>
                            <UniformGrid Columns="2">
                                <Button x:Name="BtnScreenBroadcast" Content="📡 ТРАНСЛЯЦИЯ" Height="26" Margin="0,0,2,3" FontSize="{DynamicResource FontSizeXXXSmall}"
                                        Background="{StaticResource TintRedAccent}" Foreground="White" FontWeight="Bold"
                                        BorderBrush="Transparent" BorderThickness="2"
                                        Click="BtnOpenBroadcast_Click" Style="{StaticResource FlatButton}"/>
                                <Button x:Name="BtnScreenAudience" Content="🎭 ЗРИТЕЛИ" Height="26" Margin="2,0,0,3" FontSize="{DynamicResource FontSizeXXXSmall}"
                                        Background="{StaticResource ColorInfo}" Foreground="White" FontWeight="Bold"
                                        BorderBrush="Transparent" BorderThickness="2"
                                        Click="BtnOpenAudience_Click" Style="{StaticResource FlatButton}"/>
                            </UniformGrid>
                            <!-- Кнопка открытия дополнительного Монитора 2 -->
                            <Grid>
                                <Button x:Name="BtnAddSidePanel" Height="26" Margin="0,2,0,0" FontSize="{DynamicResource FontSizeXXXSmall}"
                                        Background="{StaticResource ObsidianRaised}" Foreground="{StaticResource ObsidianTextSecondary}"
                                        BorderBrush="{StaticResource ObsidianBorderStrong}" BorderThickness="1"
                                        Click="BtnAddSidePanel_Click" Style="{StaticResource FlatButton}"
                                        ToolTip="Открыть ещё один Монитор 2 на другой вкладке">
                                    <TextBlock x:Name="TxtAddSidePanelBtn" Text="＋ МОНИТОР 2" TextAlignment="Center"/>
                                </Button>
                                <!-- Стилизованный Popup — тёмная тема -->
                                <Popup x:Name="PopupAddSidePanel"
                                       PlacementTarget="{Binding ElementName=BtnAddSidePanel}"
                                       Placement="Bottom" StaysOpen="False"
                                       AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Background="{StaticResource StudioCardBg}"
                                            BorderBrush="{StaticResource StudioCardBorder}" BorderThickness="1"
                                            CornerRadius="10" Padding="8,6" MinWidth="180">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="0" Opacity="0.25"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <Button Tag="Dashboard" Height="34" HorizontalContentAlignment="Left"
                                                    FontSize="{DynamicResource FontSizeXXSmall}"
                                                    Click="BtnAddSidePanelTab_Click" Style="{StaticResource MenuItemStyle}">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="🖥  " FontSize="11"/><TextBlock Text="Обзор"/></StackPanel>
                                            </Button>
                                            <Button Tag="Live" Height="34" HorizontalContentAlignment="Left"
                                                    FontSize="{DynamicResource FontSizeXXSmall}"
                                                    Click="BtnAddSidePanelTab_Click" Style="{StaticResource MenuItemStyle}">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="🔴  " FontSize="11"/><TextBlock Text="Эфир (Live)"/></StackPanel>
                                            </Button>
                                            <Button Tag="Analytics" Height="34" HorizontalContentAlignment="Left"
                                                    FontSize="{DynamicResource FontSizeXXSmall}"
                                                    Click="BtnAddSidePanelTab_Click" Style="{StaticResource MenuItemStyle}">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="📊  " FontSize="11"/><TextBlock Text="Аналитика"/></StackPanel>
                                            </Button>
                                            <Button Tag="Players" Height="34" HorizontalContentAlignment="Left"
                                                    FontSize="{DynamicResource FontSizeXXSmall}"
                                                    Click="BtnAddSidePanelTab_Click" Style="{StaticResource MenuItemStyle}">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="👥  " FontSize="11"/><TextBlock Text="Игроки"/></StackPanel>
                                            </Button>
                                            <Button Tag="PreGame" Height="34" HorizontalContentAlignment="Left"
                                                    FontSize="{DynamicResource FontSizeXXSmall}"
                                                    Click="BtnAddSidePanelTab_Click" Style="{StaticResource MenuItemStyle}">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="⚙  " FontSize="11"/><TextBlock Text="Подготовка"/></StackPanel>
                                            </Button>
                                            <Button Tag="Settings" Height="34" HorizontalContentAlignment="Left"
                                                    FontSize="{DynamicResource FontSizeXXSmall}"
                                                    Click="BtnAddSidePanelTab_Click" Style="{StaticResource MenuItemStyle}">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="🔧  " FontSize="11"/><TextBlock Text="Настройки"/></StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>

                            <!-- Выбор цвета хромакея -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,8">
                                <TextBlock Text="ХРОМА:" Foreground="{StaticResource ObsidianTextMuted}" FontSize="{DynamicResource FontSizeXXXSmall}" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Bold"/>
                                <Button Style="{StaticResource ChromaColorButtonStyle}" Background="{StaticResource TVSafeChroma}" Margin="2" Click="BtnChromaColor_Click" Tag="#00B140" ToolTip="Зелёный (классика)"/>
                                <Button Style="{StaticResource ChromaColorButtonStyle}" Background="#0033CC" Margin="2" Click="BtnChromaColor_Click" Tag="#0033CC" ToolTip="Синий"/>
                                <Button Style="{StaticResource ChromaColorButtonStyle}" Background="#FF00FF" Margin="2" Click="BtnChromaColor_Click" Tag="#FF00FF" ToolTip="Пурпурный"/>
                                <Button Style="{StaticResource ChromaColorButtonStyle}" Background="Black" Margin="2" Click="BtnChromaColor_Click" Tag="#000000" ToolTip="Чёрный"/>
                            </StackPanel>


                            <!-- Разделитель -->
                            <Border Height="1" Background="{StaticResource ObsidianBorder}" Margin="0,4,0,6"/>

                            <!-- === УЧАСТНИКИ === -->
                            <Button Content="👥 УЧАСТНИКИ" x:Name="BtnShowParticipants" Height="32" Margin="0,0,0,3" 
                                    Click="BtnShowParticipants_Click" Style="{StaticResource FlatButton}"
                                    Background="{StaticResource ObsidianCard}" Foreground="{StaticResource ObsidianTextPrimary}" 
                                    BorderBrush="{StaticResource ObsidianBorderStrong}" BorderThickness="1" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold"/>

                            <!-- Разделитель -->

                            <!-- === ИНСТРУМЕНТЫ === -->
                            <Button Content="✎ РЕДАКТОР ВОПРОСОВ" x:Name="BtnToggleQuestionEditor" Height="32" Margin="0,0,0,3" 
                                    Click="BtnToggleQuestionEditor_Click" Style="{StaticResource FlatButton}"
                                    Background="{StaticResource ObsidianCard}" Foreground="{StaticResource ObsidianTextPrimary}" 
                                    BorderBrush="{StaticResource ObsidianBorderStrong}" BorderThickness="1" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold"/>
                            <Button Content="📊 АНАЛИТИКА" x:Name="BtnToggleAnalytics" Height="32" Margin="0,0,0,3" 
                                    Click="BtnToggleAnalytics_Click" Style="{StaticResource FlatButton}"
                                    Background="{StaticResource ObsidianCard}" Foreground="{StaticResource ObsidianTextPrimary}" 
                                    BorderBrush="{StaticResource ObsidianBorderStrong}" BorderThickness="1" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold"/>

                            <Button Content="🧪 САМОТЕСТ" x:Name="BtnSelfTest" Height="32" Margin="0,0,0,3" 
                                    Click="BtnSelfTest_Click" Style="{StaticResource FlatButton}"
                                    Background="{StaticResource ObsidianCard}" Foreground="{StaticResource ColorOrange}" 
                                    BorderBrush="{StaticResource ObsidianBorderStrong}" BorderThickness="1" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold"/>

                            <!-- Разделитель -->
                            <Border Height="1" Background="{StaticResource ObsidianBorder}" Margin="0,6,0,6"/>

                            <!-- === DEBUG (сворачиваемый) === -->
                            <Expander IsExpanded="False" Margin="0,0,0,4">
                                <Expander.Style>
                                    <Style TargetType="Expander">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Expander">
                                                    <StackPanel>
                                                        <ToggleButton x:Name="HeaderBtn" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                                      Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Left" Padding="0,4">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border Background="Transparent" Padding="0,4">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock x:Name="Arrow" Text="▶" Foreground="{StaticResource ObsidianAccentTeal}" FontSize="{DynamicResource FontSizeXSmall}" FontWeight="Bold" Margin="0,0,6,0"/>
                                                                            <TextBlock Text="ОТЛАДКА" Foreground="{StaticResource ObsidianAccentTeal}" FontSize="{DynamicResource FontSizeXSmall}" FontWeight="Bold"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsChecked" Value="True">
                                                                            <Setter TargetName="Arrow" Property="Text" Value="▼"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                        </ToggleButton>
                                                        <ContentPresenter x:Name="Content" Visibility="Collapsed"/>
                                                    </StackPanel>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsExpanded" Value="True">
                                                            <Setter TargetName="Content" Property="Visibility" Value="Visible"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Expander.Style>
                                <StackPanel>
                                    <TextBlock Text="Раунд теста:" Foreground="{StaticResource ObsidianTextSecondary}" FontSize="{DynamicResource FontSizeXSmall}" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="TestRoundSelector" Height="25" FontSize="{DynamicResource FontSizeCaption}" SelectedIndex="0" Style="{StaticResource TestRoundSelectorStyle}" VerticalContentAlignment="Center" Margin="0,0,0,4">
                                        <ComboBoxItem Content="Раунд 1"/>
                                        <ComboBoxItem Content="Раунд 2"/>
                                        <ComboBoxItem Content="Раунд 3"/>
                                        <ComboBoxItem Content="Раунд 4"/>
                                        <ComboBoxItem Content="Раунд 5"/>
                                        <ComboBoxItem Content="Раунд 6"/>
                                        <ComboBoxItem Content="Раунд 7"/>
                                        <ComboBoxItem Content="ФИНАЛ"/>
                                    </ComboBox>
                                    <CheckBox x:Name="ChkTestLast30Sec" Content="30 сек раунд" Margin="0,3,0,0" Style="{StaticResource ObsidianCheckBox}"/>
                                    <CheckBox x:Name="ChkDebugEndRoundButton" Content="кнопка Раунд Завершен" Margin="0,3,0,4" Click="ChkDebugEndRoundButton_Click" Style="{StaticResource ObsidianCheckBox}"/>
                                    <Button Content="БЫСТРЫЙ СТАРТ" x:Name="BtnQuickStart" Height="26" FontSize="{DynamicResource FontSizeXSmall}"
                                            Background="{StaticResource ColorInfo}" Foreground="White" Margin="0,0,0,3" Padding="8,0" 
                                            Click="BtnQuickStart_Click" Style="{StaticResource FlatButton}"/>
                                    <Button Content="ЗАПОЛНИТЬ СЛУЧАЙНЫМИ" x:Name="BtnFillRandom" Height="26" FontSize="{DynamicResource FontSizeXSmall}"
                                            Background="{StaticResource ObsidianBorderStrong}" Foreground="White" Margin="0,0,0,3" Padding="8,0" 
                                            Click="BtnFillRandom_Click" Style="{StaticResource FlatButton}"/>
                                    <Button Content="🎬 ТЕСТ ФИНАЛА" x:Name="BtnDebugTestFinal" Height="26" FontSize="{DynamicResource FontSizeXSmall}"
                                            Background="{StaticResource ColorDanger}" Foreground="White" Margin="0,0,0,3" Padding="8,0" 
                                            Click="BtnDebugTestFinal_Click" Style="{StaticResource FlatButton}"/>
                                    <Button Content="⏱ ТЕСТ РАУНД 7" x:Name="BtnDebugTestRound7" Height="26" FontSize="{DynamicResource FontSizeXSmall}"
                                            Background="{StaticResource ColorWarning}" Foreground="White" Margin="0,0,0,3" Padding="8,0" 
                                            Click="BtnDebugTestRound7_Click" Style="{StaticResource FlatButton}"/>
                            
                                    <!-- ТЕСТОВАЯ ИГРА -->
                                    <Border Height="1" Background="{StaticResource ObsidianBorder}" Margin="0,6,0,6"/>
                                    <TextBlock Text="ТЕСТОВАЯ ИГРА" Foreground="{StaticResource ObsidianTextMuted}" FontSize="{DynamicResource FontSizeXSmall}" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <Button Content="Загрузить команду..." Height="26" FontSize="{DynamicResource FontSizeXSmall}" Margin="0,0,0,3"
                                            Background="{StaticResource ObsidianCard}" Foreground="{StaticResource ObsidianTextPrimary}" 
                                            BorderBrush="{StaticResource ObsidianBorderStrong}" BorderThickness="1"
                                            Click="BtnTestTeam1_Click" Style="{StaticResource FlatButton}"/>
                                </StackPanel>
                            </Expander>

                            <!-- === СЕРВИС === -->
                            <Border Height="1" Background="{StaticResource ObsidianBorder}" Margin="0,6,0,6"/>
                            <TextBlock Text="СЕРВИС" Foreground="{StaticResource ObsidianTextMuted}" FontSize="{DynamicResource FontSizeXSmall}" FontWeight="Bold" Margin="0,0,0,4"/>
                            <Border Height="1" Background="{StaticResource ObsidianBorder}" Margin="0,6,0,6"/>
                            <!-- === ЭКСПОРТ === -->
                            <Border Height="1" Background="{StaticResource ObsidianBorder}" Margin="0,6,0,6"/>
                            <TextBlock Text="ЭКСПОРТ" Foreground="{StaticResource ObsidianTextMuted}" FontSize="{DynamicResource FontSizeXSmall}" FontWeight="Bold" Margin="0,0,0,4"/>
                            <UniformGrid Columns="2" Margin="0,0,0,3">
                                <Button x:Name="BtnExportCSV2" Content="📊 CSV" Background="{StaticResource ObsidianCard}" Foreground="{StaticResource ObsidianText}" 
                                        Height="32" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold" Margin="0,0,2,0" 
                                        Click="BtnExportCSV_Click" Style="{StaticResource FlatButton}"/>
                                <Button x:Name="BtnExportHTML2" Content="📄 HTML" Background="{StaticResource ObsidianCard}" Foreground="{StaticResource ObsidianText}" 
                                        Height="32" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold" Margin="2,0,0,0"
                                        Click="BtnExportHTML_Click" Style="{StaticResource FlatButton}"/>
                            </UniformGrid>
                        </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>


            <!-- 0. Content header bar (Cursor-style) -->
            <Border Grid.Row="0" Background="#16191F" Height="32" BorderBrush="{StaticResource ObsidianBorder}" BorderThickness="0,0,0,1">
                <Grid>
                    <!-- LEFT: tools toggle + title + inline stats -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0">
                        <ToggleButton x:Name="TglServicePanel" ToolTip="Панель инструментов"
                                      Background="Transparent" BorderThickness="0" Cursor="Hand"
                                      VerticalAlignment="Center" Margin="0,0,8,0"
                                      IsChecked="False" Checked="TglServicePanel_Changed" Unchecked="TglServicePanel_Changed">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="3" Padding="6,3">
                                        <TextBlock x:Name="ico" Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource ObsidianTextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource ObsidianCard}"/>
                                            <Setter TargetName="ico" Property="Foreground" Value="{StaticResource ObsidianTextPrimary}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource ObsidianBorder}"/>
                                            <Setter TargetName="ico" Property="Foreground" Value="{StaticResource AccentPrimary}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <TextBlock Text="WEAKEST LINK" Foreground="{StaticResource ObsidianTextSecondary}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Border x:Name="TestModeBadge" Background="#16191F" BorderBrush="{StaticResource ColorOrange}" BorderThickness="1" CornerRadius="3" Padding="8,2" Visibility="Collapsed">
                            <TextBlock x:Name="TxtTestModeLabel" Text="ТЕСТ: —" Foreground="{StaticResource ColorOrange}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Border>

                        <Border Width="1" Background="{StaticResource ObsidianBorder}" Margin="6,6" VerticalAlignment="Stretch"/>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                            <TextBlock Text="БАНК" Foreground="{StaticResource ObsidianTextMuted}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="TxtCurrentBank" Text="0" Foreground="{StaticResource ColorGold}" FontSize="13" FontWeight="Bold" FontFamily="JetBrains Mono, Consolas" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Width="1" Background="{StaticResource ObsidianBorder}" Margin="6,6" VerticalAlignment="Stretch"/>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                            <TextBlock Text="ОБЩИЙ" Foreground="{StaticResource ObsidianTextMuted}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="TxtTotalBank" Text="0" Foreground="{StaticResource ColorSuccess}" FontSize="13" FontWeight="Bold" FontFamily="JetBrains Mono, Consolas" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Game state indicator -->
                    <Border x:Name="GameStateBadge" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="Transparent" Padding="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="GameStateDot" Width="6" Height="6" Fill="{StaticResource ObsidianTextMuted}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtGameStateBadge" Text="ОЖИДАНИЕ" 
                                       Foreground="{StaticResource ObsidianTextMuted}" FontSize="10" FontWeight="Normal"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="TxtPreviousBanked" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtPlayingFor" Visibility="Collapsed"/>

                    <!-- RIGHT: question count + QR -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="ВОПРОС" Foreground="{StaticResource ObsidianTextMuted}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="TxtQuestionCount" Text="0/0" Foreground="{StaticResource AccentPrimary}" FontSize="13" FontWeight="Bold" FontFamily="JetBrains Mono, Consolas" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Width="1" Background="{StaticResource ObsidianBorder}" Margin="4,6" VerticalAlignment="Stretch"/>

                        <Button x:Name="BtnShowQr" Content="QR" Click="BtnShowQr_Click"
                                Style="{StaticResource PillButtonCompact}"
                                FontSize="10" FontWeight="SemiBold" Padding="6,3" VerticalAlignment="Center"/>
                        <Popup x:Name="QrPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=BtnShowQr}"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="#16191F" BorderBrush="{StaticResource AccentPrimary}" BorderThickness="1" CornerRadius="4" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="&#x0421;&#x0415;&#x041D;&#x0421;&#x041E;&#x0420;&#x041D;&#x042B;&#x0419; &#x041F;&#x0423;&#x041B;&#x042C;&#x0422;"
                                               Foreground="{StaticResource AccentPrimary}" FontWeight="Bold" FontSize="13"
                                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <Image x:Name="QrCodeImage" Width="200" Height="200"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    <TextBlock x:Name="TxtQrUrl" Foreground="{StaticResource ObsidianTextSecondary}" FontSize="11"
                                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="TxtQrHint" Foreground="{StaticResource ColorDanger}" FontSize="10"
                                               HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="220"
                                               Visibility="Collapsed"/>
                                    <TextBlock Text="PIN: 0000" Foreground="{StaticResource ObsidianTextMuted}" FontSize="10"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Grid>
            </Border>

<!-- 1. FUTURIST TIMER HUB (Sketched Semi-Circle & Wings) -->
            <Grid Grid.Row="1" Margin="10,5,10,10" ClipToBounds="False">
                <Grid.Resources>
                    <Storyboard x:Key="TimerHubPulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetName="TimerArchBorder"
                                         Storyboard.TargetProperty="Opacity"
                                         From="1.0" To="0.55" Duration="0:0:0.6"/>
                    </Storyboard>
                </Grid.Resources>

                <!-- 1A: STATS BAR — перенесён в шапку -->

                <!-- 1B: Round Number (floating center badge) — СКРЫТ -->
                <Border x:Name="TimerArchBorder" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-20"
                        CornerRadius="{DynamicResource CornerRadiusXLarge}" Background="#16191F" BorderBrush="{StaticResource ObsidianBorderStrong}" BorderThickness="1"
                        Padding="20,4" Panel.ZIndex="10" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtRoundNumberCenter" Text="1" Foreground="{StaticResource ColorInfo}" 
                                   FontSize="{DynamicResource FontSizeDisplay}" FontWeight="Bold" FontFamily="JetBrains Mono, Consolas"
                                   HorizontalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#007ACC" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="РАУНД" Foreground="{StaticResource ObsidianTextDisabled}" FontSize="{DynamicResource FontSizeXSmall}" FontWeight="Bold" 
                                   HorizontalAlignment="Center" Margin="0,-2,0,2"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2. СЕЙЧАС / ШАГ / ХИНТ -->
            <Border x:Name="YouMadeBorder" Grid.Row="2" Background="#2D1515" Margin="10,0,10,8" CornerRadius="3" Padding="5" Visibility="Collapsed">
                <TextBlock x:Name="TxtYouMade" Text="ВЫ СДЕЛАЛИ: —" Foreground="White" FontSize="{DynamicResource FontSizeHeader}" FontWeight="Bold" HorizontalAlignment="Center"/>
            </Border>

            <!-- 3. ОСНОВНАЯ РАБОЧАЯ ОБЛАСТЬ -->
            <Grid Grid.Row="3" Background="#0F1115">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="GameFlowStates">
                        <VisualState x:Name="SetupState">
                            <Storyboard>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SetupPanel" Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                                </ObjectAnimationUsingKeyFrames>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PlayContext" Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                                </ObjectAnimationUsingKeyFrames>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="GamePlayPanel" Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                                </ObjectAnimationUsingKeyFrames>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HeadToHeadPanel" Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                                </ObjectAnimationUsingKeyFrames>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="WinnerPanel" Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                                </ObjectAnimationUsingKeyFrames>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BtnBotTurn" Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                                </ObjectAnimationUsingKeyFrames>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TglAutoBot" Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                                </ObjectAnimationUsingKeyFrames>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BtnToFinal" Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                                </ObjectAnimationUsingKeyFrames>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RevealProgressPanel" Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                                </ObjectAnimationUsingKeyFrames>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TxtQuickEditQuestion" Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                                </ObjectAnimationUsingKeyFrames>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TxtQuickEditAnswer" Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </VisualState>
                        <VisualState x:Name="PlayingState">
                            <Storyboard>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SetupPanel" Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                                </ObjectAnimationUsingKeyFrames>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PlayContext" Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                                </ObjectAnimationUsingKeyFrames>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="GamePlayPanel" Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
