<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════
         CURSOR IDE THEME v1.0 — Monochrome dark palette
         Based on VS Code / Cursor IDE design language
         ═══════════════════════════════════════════════════════════════ -->

    <!-- ═══ NEUTRAL COLORS — Core surfaces ═══ -->
    <SolidColorBrush x:Key="ObsidianBase"           Color="#181818"/>  <!-- deepest bg (activity bar, title bar) -->
    <SolidColorBrush x:Key="ObsidianAppBg"          Color="#0D0F13"/>  <!-- app window background (Bento dark) -->
    <SolidColorBrush x:Key="ObsidianBg"             Color="#1E1E1E"/>  <!-- main editor background (legacy) -->
    <SolidColorBrush x:Key="ObsidianSurface"        Color="#252526"/>  <!-- panels, cards, sidebars -->
    <SolidColorBrush x:Key="ObsidianDeep"           Color="#181818"/>  <!-- status bar bg (inactive) -->
    <SolidColorBrush x:Key="ObsidianCard"           Color="#2D2D2D"/>  <!-- raised card, input bg -->
    <SolidColorBrush x:Key="ObsidianRaised"         Color="#333333"/>  <!-- highest elevation surface -->
    <SolidColorBrush x:Key="ObsidianBorder"         Color="#2D2D2D"/>  <!-- default border -->
    <SolidColorBrush x:Key="ObsidianBorderStrong"   Color="#3D3D3D"/>  <!-- stronger border (focus, hover) -->
    <SolidColorBrush x:Key="ObsidianBorderLight"    Color="#4D4D4D"/>  <!-- hover highlight border -->

    <!-- ═══ TEXT COLORS — Typography hierarchy ═══ -->
    <SolidColorBrush x:Key="ObsidianTextPrimary"   Color="#CCCCCC"/>  <!-- primary text -->
    <SolidColorBrush x:Key="ObsidianText"          Color="#D4D4D4"/>  <!-- alt primary (slightly brighter) -->
    <SolidColorBrush x:Key="ObsidianTextSecondary" Color="#858585"/>  <!-- secondary / labels -->
    <SolidColorBrush x:Key="ObsidianTextMuted"     Color="#5A5A5A"/>  <!-- muted / placeholders -->
    <SolidColorBrush x:Key="ObsidianTextDisabled"  Color="#4D4D4D"/>  <!-- disabled state -->

    <!-- ═══ ACCENT — Primary action color (VS Code blue) ═══ -->
    <SolidColorBrush x:Key="AccentPrimary"         Color="#007ACC"/>  <!-- primary accent -->
    <SolidColorBrush x:Key="AccentHover"           Color="#1177BB"/>  <!-- accent hover -->
    <SolidColorBrush x:Key="AccentSelection"       Color="#264F78"/>  <!-- selection highlight -->

    <!-- ═══ SEMANTIC COLORS — Status indicators ═══ -->
    <SolidColorBrush x:Key="ColorSuccess"          Color="#4EC9B0"/>  <!-- success (teal-green, VS Code) -->
    <SolidColorBrush x:Key="ColorDanger"           Color="#F14C4C"/>  <!-- error / danger -->
    <SolidColorBrush x:Key="ColorWarning"          Color="#CCA700"/>  <!-- warning (muted gold) -->
    <SolidColorBrush x:Key="ColorInfo"             Color="#007ACC"/>  <!-- info (accent blue) -->

    <!-- ═══ GAME COLORS — Game-specific (kept functional) ═══ -->
    <SolidColorBrush x:Key="ColorGreen"            Color="#4EC9B0"/>  <!-- correct answer -->
    <SolidColorBrush x:Key="ColorGold"             Color="#CCA700"/>  <!-- bank / money -->
    <SolidColorBrush x:Key="ColorRed"              Color="#F14C4C"/>  <!-- wrong / danger -->
    <SolidColorBrush x:Key="ColorBlurple"          Color="#007ACC"/>  <!-- primary action (start) -->
    <SolidColorBrush x:Key="ColorOrange"           Color="#CE9178"/>  <!-- warning (VS Code string color) -->
    <SolidColorBrush x:Key="ColorPurple"           Color="#C586C0"/>  <!-- debug / tech (VS Code keyword) -->
    <SolidColorBrush x:Key="ColorTeal"             Color="#4EC9B0"/>  <!-- accent checked states -->
    <SolidColorBrush x:Key="ColorTeams"            Color="#007ACC"/>  <!-- navigation active (was Teams purple) -->

    <!-- ═══ TV-SAFE COLORS — Broadcast / Host screens ═══ -->
    <SolidColorBrush x:Key="TVSafeBackground"      Color="#0A0A0A"/>  <!-- deepest broadcast bg -->
    <SolidColorBrush x:Key="TVSafeDark"            Color="#141414"/>  <!-- dark broadcast area -->
    <SolidColorBrush x:Key="TVSafePanel"           Color="#1A1A1A"/>  <!-- broadcast panel -->
    <SolidColorBrush x:Key="TVSafeBorder"          Color="#2D2D2D"/>  <!-- broadcast border -->
    <SolidColorBrush x:Key="TVSafeSubtle"          Color="#0D0D0D"/>  <!-- barely visible bg -->
    <SolidColorBrush x:Key="TVSafeNear"            Color="#111111"/>  <!-- near-black -->
    <SolidColorBrush x:Key="TVSafeMid"             Color="#1E1E1E"/>  <!-- mid dark -->
    <SolidColorBrush x:Key="TVSafeGray"            Color="#3D3D3D"/>  <!-- broadcast gray -->
    <SolidColorBrush x:Key="TVSafeGrayMid"         Color="#2D2D2D"/>  <!-- mid gray broadcast -->
    <SolidColorBrush x:Key="TVSafeGrayLight"       Color="#4D4D4D"/>  <!-- light gray broadcast -->
    <SolidColorBrush x:Key="TVSafeQuestionBg"      Color="#0A1628"/>  <!-- Navy Dark (question) -->
    <SolidColorBrush x:Key="TVSafeAnswer"          Color="#F14C4C"/>  <!-- Red (answer) -->
    <SolidColorBrush x:Key="TVSafeCyan"            Color="#4EC9B0"/>  <!-- Cyan/teal (finalists) -->
    <SolidColorBrush x:Key="TVSafeTimer"           Color="#007ACC"/>  <!-- Timer (accent blue) -->
    <SolidColorBrush x:Key="TVSafeBankNow"         Color="#264F78"/>  <!-- Bank now (selection blue) -->
    <SolidColorBrush x:Key="TVSafeTotal"           Color="#3B1D4A"/>  <!-- Burgundy/purple -->
    <SolidColorBrush x:Key="TVSafeChroma"          Color="#00B140"/>  <!-- Chromakey Green -->

    <!-- ═══ ALIASES — Backward compatibility ═══ -->
    <SolidColorBrush x:Key="AccentSuccess"         Color="#4EC9B0"/>
    <SolidColorBrush x:Key="AccentWarning"         Color="#CCA700"/>
    <SolidColorBrush x:Key="AccentDanger"          Color="#F14C4C"/>
    <SolidColorBrush x:Key="ObsidianAccentTeal"    Color="#4EC9B0"/>

    <!-- ═══ BUTTON COLORS — Fire Buttons (game-critical, kept vivid) ═══ -->
    <SolidColorBrush x:Key="FireButtonCorrect"     Color="#16825D"/>  <!-- CORRECT (muted green) -->
    <SolidColorBrush x:Key="FireButtonCorrectHover" Color="#1A9E6F"/>
    <SolidColorBrush x:Key="FireButtonCorrectPress" Color="#12704F"/>

    <SolidColorBrush x:Key="FireButtonBank"        Color="#0E639C"/>  <!-- BANK (VS Code button blue) -->
    <SolidColorBrush x:Key="FireButtonBankHover"   Color="#1177BB"/>
    <SolidColorBrush x:Key="FireButtonBankPress"   Color="#0A5181"/>

    <SolidColorBrush x:Key="FireButtonWrong"       Color="#C72828"/>  <!-- WRONG (muted red) -->
    <SolidColorBrush x:Key="FireButtonWrongHover"  Color="#DB3434"/>
    <SolidColorBrush x:Key="FireButtonWrongPress"  Color="#A52020"/>

    <SolidColorBrush x:Key="FireButtonPass"        Color="#3C3C3C"/>  <!-- PASS (neutral gray) -->
    <SolidColorBrush x:Key="FireButtonPassHover"   Color="#4A4A4A"/>
    <SolidColorBrush x:Key="FireButtonPassPress"   Color="#303030"/>

    <!-- ═══ MONEY CHAIN COLORS ═══ -->
    <SolidColorBrush x:Key="ChainActive"           Color="#007ACC"/>  <!-- active level (accent blue) -->
    <SolidColorBrush x:Key="ChainInactive"         Color="#252526"/>  <!-- inactive level -->

    <!-- ═══ STATUS COLORS ═══ -->
    <SolidColorBrush x:Key="StatusOnline"          Color="#4EC9B0"/>  <!-- online (teal) -->
    <SolidColorBrush x:Key="StatusWarning"         Color="#CCA700"/>  <!-- waiting (gold) -->
    <SolidColorBrush x:Key="StatusOffline"         Color="#4D4D4D"/>  <!-- eliminated (gray) -->

    <!-- ═══ GAME TINT COLORS — Card/status backgrounds ═══ -->
    <SolidColorBrush x:Key="TintGreenDark"         Color="#0D2818"/>  <!-- dark green tint -->
    <SolidColorBrush x:Key="TintRedDark"           Color="#2D0F0F"/>  <!-- dark red tint -->
    <SolidColorBrush x:Key="TintBlueDark"          Color="#0D1B2A"/>  <!-- dark blue tint (current player) -->
    <SolidColorBrush x:Key="TintGreenBright"       Color="#4EC9B0"/>  <!-- bright green -->
    <SolidColorBrush x:Key="TintRedBright"         Color="#F14C4C"/>  <!-- bright red -->
    <SolidColorBrush x:Key="TintRedAccent"         Color="#C72828"/>  <!-- accent red -->
    <SolidColorBrush x:Key="TintGreenAccent"       Color="#16825D"/>  <!-- accent green -->

    <!-- ═══ ANALYTICS STUDIO VARIANT — Dark dashboards (breathing, elevation, teal) ═══ -->
    <SolidColorBrush x:Key="StudioCardBg"          Color="#1A1D24"/>  <!-- card surface (lighter than Obsidian) -->
    <SolidColorBrush x:Key="StudioCardBorder"       Color="#2D323E"/>  <!-- soft border -->
    <SolidColorBrush x:Key="StudioAccent"           Color="#14B8A6"/>   <!-- teal primary (Hi Dog / docpanel style) -->
    <SolidColorBrush x:Key="StudioBg"              Color="#0F1115"/>  <!-- inner panel bg -->
    <SolidColorBrush x:Key="StudioTextMuted"       Color="#8B92A4"/>  <!-- labels -->
    <DropShadowEffect x:Key="StudioCardShadow" BlurRadius="20" ShadowDepth="0" Opacity="0.15" Color="Black"/>

    <!-- ═══════════════════════════════════════════════════════════════
         COMPONENT STYLES — Cursor IDE look
         ═══════════════════════════════════════════════════════════════ -->

    <!-- ObsidianTextBox: minimal input with focus accent -->
    <Style x:Key="ObsidianTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="#313131"/>
        <Setter Property="Foreground" Value="{StaticResource ObsidianTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ObsidianBorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{StaticResource ObsidianTextPrimary}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="false"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource ObsidianBorderLight}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- PremiumTextBox: DocPanel-style dark input with teal focus + blue glow (7b4ca548) -->
    <Style x:Key="PremiumTextBox" TargetType="TextBox" BasedOn="{StaticResource ObsidianTextBox}">
        <Setter Property="Background" Value="#16191F"/>
        <Setter Property="BorderBrush" Value="#252A36"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="CaretBrush" Value="White"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="false"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource StudioAccent}"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            <Setter TargetName="border" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#007ACC" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#2D323E"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Editor TextBox with red focus ring -->
    <Style x:Key="EditorTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="#313131"/>
        <Setter Property="Foreground" Value="{StaticResource ObsidianTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ObsidianBorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{StaticResource ObsidianTextPrimary}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentSelection}"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="false"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource ColorDanger}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource ObsidianBorderLight}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thin scrollbar thumb (Cursor/VS Code style) -->
    <Style x:Key="DiscordScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="thumbBorder" Background="#424242" CornerRadius="4" Margin="1"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="thumbBorder" Property="Background" Value="#555555"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="thumbBorder" Property="Background" Value="#686868"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cursor-style flat button with subtle hover overlay -->
    <Style x:Key="DiscordButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource ObsidianTextPrimary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="hoverOverlay" Background="White" Opacity="0" CornerRadius="8"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"
                                              TextBlock.FontSize="{TemplateBinding FontSize}"
                                              TextBlock.FontWeight="{TemplateBinding FontWeight}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hoverOverlay" Property="Opacity" Value="0.06"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="hoverOverlay" Property="Opacity" Value="0.0"/>
                            <Setter TargetName="btnBorder" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="btnBorder" Property="Opacity" Value="0.4"/>
                            <Setter TargetName="hoverOverlay" Property="Opacity" Value="0"/>
                            <Setter Property="Foreground" Value="{StaticResource ObsidianTextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TestRoundSelector ComboBox -->
    <Style x:Key="TestRoundSelectorStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="#16191F"/>
        <Setter Property="Foreground" Value="{StaticResource ObsidianTextPrimary}"/>
        <Setter Property="BorderBrush" Value="#252A36"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource PremiumComboBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" Grid.Column="2" Focusable="false"
                                      IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="TkBorder" Background="#16191F" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                        <Path x:Name="Arrow" Fill="{StaticResource ObsidianTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Data="M0,0 L4,4 L8,0 Z"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TkBorder" Property="BorderBrush" Value="{StaticResource ObsidianBorderLight}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="TkBorder" Property="Background" Value="{StaticResource ObsidianRaised}"/>
                                            <Setter TargetName="TkBorder" Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ToggleButton.Background>
                                <TemplateBinding Property="Background"/>
                            </ToggleButton.Background>
                            <ToggleButton.BorderBrush>
                                <TemplateBinding Property="BorderBrush"/>
                            </ToggleButton.BorderBrush>
                            <ToggleButton.BorderThickness>
                                <TemplateBinding Property="BorderThickness"/>
                            </ToggleButton.BorderThickness>
                        </ToggleButton>
                        <TextBlock x:Name="ContentSite" IsHitTestVisible="False"
                                  Text="{TemplateBinding Text}"
                                  Margin="10,0,25,0"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  Foreground="{StaticResource ObsidianTextPrimary}"/>

                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border x:Name="DropDownBorder" Background="#16191F" BorderThickness="1" BorderBrush="#252A36" CornerRadius="0,0,8,8" Padding="2"/>
                                <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Backward compat alias -->
    <Style x:Key="NoWhiteWhenDisabledButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"/>

    <!-- Game button with physical press effect (fire buttons) -->
    <Style x:Key="GameButtonPressStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="#181818" BorderThickness="0,0,0,3" Padding="{TemplateBinding Padding}" CornerRadius="10" SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.25" Color="#000000"/>
                        </Border.Effect>
                        <ContentPresenter x:Name="content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="BorderThickness" Value="0,2,0,0"/>
                            <Setter TargetName="border" Property="Margin" Value="0,2,0,-2"/>
                            <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.92"/>
                            <Setter TargetName="border" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect ShadowDepth="1" BlurRadius="14" Opacity="0.35" Color="#000000"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.35"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ FIRE BUTTON STYLES ═══ -->

    <Style x:Key="FireCorrectButton" TargetType="Button" BasedOn="{StaticResource GameButtonPressStyle}">
        <Setter Property="Background" Value="{StaticResource FireButtonCorrect}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="FireBankButton" TargetType="Button" BasedOn="{StaticResource GameButtonPressStyle}">
        <Setter Property="Background" Value="{StaticResource FireButtonBank}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="FireWrongButton" TargetType="Button" BasedOn="{StaticResource GameButtonPressStyle}">
        <Setter Property="Background" Value="{StaticResource FireButtonWrong}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="FirePassButton" TargetType="Button" BasedOn="{StaticResource GameButtonPressStyle}">
        <Setter Property="Background" Value="{StaticResource FireButtonPass}"/>
        <Setter Property="Foreground" Value="{StaticResource ObsidianTextPrimary}"/>
    </Style>

    <!-- Segmented ToggleStyle — pill-табы как в DocPanel Case Details (активный = teal) -->
    <Style x:Key="SegmentedToggleStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource StudioTextMuted}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#1AFFFFFF"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource StudioAccent}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter TargetName="bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="8" Opacity="0.2" Color="#14B8A6"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Flat ToggleButton with premium solid shape -->
    <Style x:Key="FlatToggleStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="#21252D"/>
        <Setter Property="Foreground" Value="#B4B9C9"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#2A2F3A"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="tglBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"
                                          TextBlock.FontSize="{TemplateBinding FontSize}"
                                          TextBlock.FontWeight="{TemplateBinding FontWeight}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="tglBorder" Property="Background" Value="#2A303C"/>
                            <Setter TargetName="tglBorder" Property="BorderBrush" Value="#353B47"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
