<Window x:Class="WeakestLink.Views.AudienceScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audience Screen" Background="Black"
        Width="1920" Height="1080"
        WindowStyle="None" ResizeMode="NoResize"
        WindowState="Maximized"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Viewbox Stretch="Uniform">
        <Grid Width="1920" Height="1080" Background="Black">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── ЛЕВАЯ КОЛОНКА: ЦЕПОЧКА (текстовый список) ── -->
            <StackPanel x:Name="ChainPanel" Grid.Column="0"
                        VerticalAlignment="Bottom"
                        Margin="40,0,0,60">
            </StackPanel>

            <!-- Скрытый Canvas для совместимости -->
            <Canvas x:Name="ChainCanvas" Visibility="Collapsed"/>

            <!-- ── ПРАВАЯ ЧАСТЬ: ТАЙМЕР + БАНК ── -->
            <Grid x:Name="RoundInfoPanel" Grid.Column="1" Margin="40,0,40,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ТАЙМЕР -->
                <Viewbox Grid.Row="0" 
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         MaxWidth="800" MaxHeight="400">
                    <TextBlock x:Name="TxtTimer"
                               Text="—:——"
                               FontFamily="Arial Black"
                               FontSize="200"
                               FontWeight="ExtraBold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                </Viewbox>

                <!-- БАНК -->
                <Viewbox Grid.Row="1" 
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         MaxWidth="1000" MaxHeight="400">
                    <TextBlock x:Name="TxtBank"
                               Text="0"
                               FontFamily="Arial Black"
                               FontSize="200"
                               FontWeight="ExtraBold"
                               Foreground="#00FF66"
                               HorizontalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#00FF66" BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Viewbox>
            </Grid>

            <!-- ── ФИНАЛЬНАЯ ДУЭЛЬ ── -->
            <Grid x:Name="FinalDuelOverlay" Grid.ColumnSpan="2" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,120">
                    <!-- Игрок 1 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                        <Grid Width="260" Height="100" Margin="0,0,20,0">
                            <Image x:Name="ImgNameplate1" Stretch="Fill"/>
                            <TextBlock x:Name="TxtFinalPlayer1" Text=""
                                       FontFamily="Arial Black" FontSize="22" FontWeight="ExtraBold"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1" Opacity="0.8"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </Grid>
                        <StackPanel x:Name="FinalRow1" Orientation="Horizontal"/>
                    </StackPanel>
                    <!-- Игрок 2 -->
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="260" Height="100" Margin="0,0,20,0">
                            <Image x:Name="ImgNameplate2" Stretch="Fill"/>
                            <TextBlock x:Name="TxtFinalPlayer2" Text=""
                                       FontFamily="Arial Black" FontSize="22" FontWeight="ExtraBold"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1" Opacity="0.8"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </Grid>
                        <StackPanel x:Name="FinalRow2" Orientation="Horizontal"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Скрытые элементы для совместимости с C# -->
            <TextBlock x:Name="TxtRound" Visibility="Collapsed"/>
            <TextBlock x:Name="TxtPlayerName" Visibility="Collapsed"/>
            <TextBlock x:Name="TxtPhase" Visibility="Collapsed"/>

            <!-- ── ЛОГО-ОВЕРЛЕЙ ── -->
            <Grid x:Name="LogoOverlay"
                  Grid.ColumnSpan="2"
                  Background="Black"
                  Visibility="Collapsed">
                <Image x:Name="ImgLogo"
                       Stretch="Uniform"
                       MaxWidth="1400" MaxHeight="900"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Viewbox>

</Window>
