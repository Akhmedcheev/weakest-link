<Window x:Class="WeakestLink.Views.ServiceScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Service &amp; Maintenance" Height="420" Width="550"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#1e1f22">
    <Window.Resources>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.6"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="⚙ ТЕХНИЧЕСКОЕ ОБСЛУЖИВАНИЕ" Grid.Row="0" Foreground="White" FontSize="20" FontWeight="Bold"/>

        <Border Grid.Row="2" Background="#2b2d31" CornerRadius="8" Padding="15">
            <StackPanel>
                <TextBlock Text="USB МАКРОПАД" Foreground="#b5bac1" FontWeight="Bold" Margin="0,0,0,10"/>
                
                <TextBlock Text="Прошивка Mini KeyBoard для игры «Слабое Звено»:" Margin="0,0,0,5" Foreground="White" TextWrapping="Wrap"/>
                <TextBlock Text="• Кнопка 1: ВЕРНО (Стрелка вправо)&#x0a;• Кнопка 2: НЕВЕРНО (Стрелка влево)&#x0a;• Кнопка 3: БАНК (Пробел)&#x0a;• Кнопка 4: READY (Стрелка вверх)" Margin="10,0,0,15" Foreground="#949ba4"/>

                <Button x:Name="BtnProgramPad" Content="СИНХРОНИЗИРОВАТЬ МАКРОПАД" 
                        Height="45" Background="#5865F2" Foreground="White" FontWeight="Bold" FontSize="14"
                        Style="{StaticResource FlatButton}" Click="BtnProgramPad_Click"/>
                
                <TextBlock x:Name="TxtStatus" Text="В ожидании макропада..." Margin="0,15,0,0" Foreground="#23a559" TextAlignment="Center" FontWeight="DemiBold"/>
            </StackPanel>
        </Border>

        <Button Grid.Row="3" Content="ЗАКРЫТЬ" Height="30" Width="100" HorizontalAlignment="Right" Margin="0,20,0,0"
                Background="#cc3333" Foreground="White" FontWeight="Bold" Style="{StaticResource FlatButton}" Click="BtnClose_Click"/>
    </Grid>
</Window>
