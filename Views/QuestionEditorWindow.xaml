<Window x:Class="WeakestLink.Views.QuestionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QUESTION EDITOR [CORE]" Height="750" Width="1000"
        Background="{StaticResource TVSafeSubtle}" Foreground="{StaticResource ObsidianTextPrimary}"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanMinimize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="{DynamicResource CornerRadiusNone}"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource TVSafeBorder}" BorderThickness="1" Background="{StaticResource TVSafeSubtle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. CUSTOM TITLE BAR -->
            <Border Grid.Row="0" Background="{StaticResource TVSafePanel}" BorderBrush="{StaticResource TVSafeBorder}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="QUESTION EDITOR [CORE]" 
                               Foreground="{StaticResource ObsidianTextDisabled}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" 
                               VerticalAlignment="Center" Margin="15,0" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="—" Style="{StaticResource WindowControlButton}" Click="BtnMinimize_Click"/>
                        <Button Content="✕" Style="{StaticResource WindowCloseButton}" Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. TOOLBAR (GROUPED) -->
            <Border Grid.Row="1" Background="{StaticResource TVSafeNear}" Padding="15,10" BorderBrush="{StaticResource TVSafeBorder}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- File Operations -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button x:Name="BtnLoad" Content="ЗАГРУЗИТЬ JSON" Style="{StaticResource GhostButton}" Click="BtnLoad_Click" Margin="0,0,8,0"/>
                        <Button x:Name="BtnSave" Content="СОХРАНИТЬ JSON" Style="{StaticResource GhostButton}" Click="BtnSave_Click"/>
                    </StackPanel>

                    <!-- Question Manipulation -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BtnAdd" Content="ДОБАВИТЬ ВОПРОС" Style="{StaticResource GhostButton}" Click="BtnAdd_Click" Margin="0,0,8,0"/>
                        <Button x:Name="BtnDelete" Content="УДАЛИТЬ" Style="{StaticResource DangerGhostButton}" Click="BtnDelete_Click" Margin="0,0,8,0"/>
                        <Button x:Name="BtnClear" Content="ОЧИСТИТЬ ВСЕ" Style="{StaticResource DangerGhostButton}" Click="BtnClear_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtStatus" Text="IDLE" Grid.Column="2" Foreground="{StaticResource ObsidianBorderStrong}" FontSize="{DynamicResource FontSizeXSmall}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <!-- 3. DATA PRESENTATION -->
            <Grid Grid.Row="2" Margin="15,15,15,5">
                <DataGrid x:Name="QuestionsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" Foreground="{StaticResource ObsidianTextPrimary}" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#202020"
                          BorderThickness="1" BorderBrush="{StaticResource TVSafeBorder}"
                          SelectionMode="Single" SelectionChanged="QuestionsGrid_SelectionChanged"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          RowHeaderWidth="0">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#161616"/>
                            <Setter Property="Foreground" Value="#808080"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#262626"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#1A1A1A"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1a1a1a"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#da373c"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#121212"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="ТЕКСТ ВОПРОСА" Binding="{Binding Text}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="10,5"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextWrapping" Value="NoWrap"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="ОТВЕТ" Binding="{Binding CorrectAnswer}" Width="200">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="Foreground" Value="#da373c"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="10,5"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#da373c"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="РАУНД" Binding="{Binding Round}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#808080"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- 4. EDITING CONSOLE -->
            <Border Grid.Row="3" Background="{StaticResource TVSafePanel}" BorderBrush="{StaticResource TVSafeBorder}" BorderThickness="0,1,0,0" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <!-- Question Input -->
                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                            <TextBlock Text="ТЕКСТ ВОПРОСА" FontSize="{DynamicResource FontSizeXSmall}" Foreground="{StaticResource ObsidianTextMuted}" Margin="2,0,0,5" FontWeight="Bold"/>
                            <TextBox x:Name="TxtEditText" Style="{StaticResource EditorTextBoxStyle}" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                        </StackPanel>

                        <!-- Answer Input -->
                        <StackPanel Grid.Column="1" Margin="0,0,15,0">
                            <TextBlock Text="ПРАВИЛЬНЫЙ ОТВЕТ" FontSize="{DynamicResource FontSizeXSmall}" Foreground="{StaticResource ObsidianTextMuted}" Margin="2,0,0,5" FontWeight="Bold"/>
                            <TextBox x:Name="TxtEditAnswer" Style="{StaticResource EditorTextBoxStyle}" Height="38"/>
                        </StackPanel>

                        <!-- Round Input -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="РАУНД" FontSize="{DynamicResource FontSizeXSmall}" Foreground="{StaticResource ObsidianTextMuted}" Margin="2,0,0,5" FontWeight="Bold"/>
                            <TextBox x:Name="TxtEditRound" Style="{StaticResource EditorTextBoxStyle}" Height="38" HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Large Accent Action Button -->
                    <Button Grid.Row="1" x:Name="BtnApplyEdit" Content="ПРИМЕНИТЬ ИЗМЕНЕНИЯ" 
                            Style="{StaticResource AccentButton}" Height="45" Margin="0,20,0,0" 
                            Click="BtnApplyEdit_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
